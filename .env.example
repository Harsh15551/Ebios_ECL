# ========================================================
# ECL Ebios Biometric Integration - Environment Template
# Copy this file to .env and configure your actual secrets
# ========================================================

# PostgreSQL Database Connection
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=ecl_ebios;Username=postgres;Password=YOUR_POSTGRES_PASSWORD;Include Error Detail=true

# eBioServer Central SOAP API Credentials
EBIOS_URL=http://YOUR_EBIOS_SERVER_IP:82/webservice.asmx
EBIOS_USERNAME=YOUR_EBIOS_USERNAME
EBIOS_PASSWORD=YOUR_EBIOS_PASSWORD

# eBioServer Webhook AES-256 Decryption Key (32 characters)
EBIOS_WEBHOOK_KEY=YOUR_32_CHAR_AES_KEY_HERE
