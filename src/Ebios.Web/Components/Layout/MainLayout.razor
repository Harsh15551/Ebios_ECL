@inherits LayoutComponentBase
@inject UserSessionService UserSession
@inject IUserService UserService
@inject NavigationManager Navigation
@implements IDisposable

@if (!UserSession.IsAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Redirecting to login...</p>
        </div>
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="fw-bold text-dark">Eastern Coalfields Limited</span>
                    <span class="mx-2 text-muted">|</span>
                    <span class="small text-muted">Central Biometric Attendance Portal</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <span class="spinner-grow spinner-grow-sm me-1 text-success" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                        eBios Online
                    </span>

                    <!-- Active User Profile & Logout -->
                    <div class="d-flex align-items-center bg-white border rounded px-3 py-1 shadow-sm gap-2">
                        <span class="small text-muted">Officer:</span>
                        <strong class="text-dark small">@UserSession.CurrentUser?.FullName</strong>

                        @if (UserSession.IsSuperAdmin)
                        {
                            <span class="badge bg-danger">HQ SuperAdmin</span>
                        }
                        else if (UserSession.IsAreaAdmin)
                        {
                            <span class="badge bg-primary">Area Admin (@UserSession.CurrentUser?.AreaName)</span>
                        }
                        else if (UserSession.IsUnitAdmin)
                        {
                            <span class="badge bg-info text-dark">Unit Manager (@UserSession.CurrentUser?.SubAreaName)</span>
                        }

                        <a href="security/2fa" class="btn btn-sm btn-outline-secondary ms-1 py-0 px-2" title="Two-Factor Authentication Security Settings">
                            <i class="bi bi-shield-lock me-1 text-primary"></i> 2FA
                        </a>
                        <button class="btn btn-sm btn-outline-secondary ms-1 py-0 px-2" @onclick="OpenChangePasswordModal" title="Change your login password">
                            <i class="bi bi-key me-1 text-warning"></i> Password
                        </button>
                        <button class="btn btn-sm btn-outline-danger ms-2 py-0 px-2 fw-semibold" @onclick="HandleLogout" title="Sign out of current account">
                            🚪 Logout
                        </button>
                    </div>
                </div>
            </div>

            <article class="content px-4 py-3">
                @Body
            </article>
        </main>
    </div>

    @if (showChangePasswordModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title fs-6 fw-bold">
                            <i class="bi bi-key-fill text-warning me-2"></i>Change Account Password
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseChangePasswordModal" disabled="@isChangingPassword"></button>
                    </div>
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(changePasswordError))
                        {
                            <div class="alert alert-danger py-2 small mb-3">@changePasswordError</div>
                        }
                        @if (!string.IsNullOrEmpty(changePasswordSuccess))
                        {
                            <div class="alert alert-success py-2 small mb-3">
                                <i class="bi bi-check-circle-fill me-1"></i> @changePasswordSuccess
                            </div>
                        }

                        @if (string.IsNullOrEmpty(changePasswordSuccess))
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Current Password</label>
                                <input type="password" class="form-control" placeholder="Enter your current password" @bind="currentPassword" disabled="@isChangingPassword" autofocus />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">New Password</label>
                                <input type="password" class="form-control" placeholder="Minimum 6 characters" @bind="newPassword" disabled="@isChangingPassword" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Confirm New Password</label>
                                <input type="password" class="form-control" placeholder="Re-enter new password" @bind="confirmNewPassword" disabled="@isChangingPassword" />
                            </div>
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseChangePasswordModal" disabled="@isChangingPassword">
                                    Cancel
                                </button>
                                <button type="button" class="btn btn-primary btn-sm fw-semibold" @onclick="HandleChangePasswordSubmit" disabled="@isChangingPassword">
                                    @if (isChangingPassword)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-check2 me-1"></i> Update Password</span>
                                    }
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-end">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="CloseChangePasswordModal">
                                    Done
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool showChangePasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmNewPassword = "";
    private string? changePasswordError;
    private string? changePasswordSuccess;
    private bool isChangingPassword = false;

    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
        if (!UserSession.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
        }
    }

    private void OpenChangePasswordModal()
    {
        showChangePasswordModal = true;
        currentPassword = "";
        newPassword = "";
        confirmNewPassword = "";
        changePasswordError = null;
        changePasswordSuccess = null;
        isChangingPassword = false;
    }

    private void CloseChangePasswordModal()
    {
        showChangePasswordModal = false;
    }

    private async Task HandleChangePasswordSubmit()
    {
        changePasswordError = null;
        changePasswordSuccess = null;

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            changePasswordError = "Please enter your current password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 6)
        {
            changePasswordError = "New password must be at least 6 characters long.";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            changePasswordError = "New password and confirmation do not match.";
            return;
        }

        if (UserSession.CurrentUser == null)
        {
            changePasswordError = "No active user session.";
            return;
        }

        isChangingPassword = true;
        try
        {
            var result = await UserService.ChangePasswordAsync(UserSession.CurrentUser.Id, currentPassword, newPassword);
            if (result.Success)
            {
                changePasswordSuccess = "Password updated successfully!";
                currentPassword = "";
                newPassword = "";
                confirmNewPassword = "";
            }
            else
            {
                changePasswordError = result.Message;
            }
        }
        catch (Exception ex)
        {
            changePasswordError = $"Failed to change password: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private void HandleLogout()
    {
        UserSession.Logout();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
