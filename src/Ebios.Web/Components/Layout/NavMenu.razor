@inject UserSessionService UserSession
@implements IDisposable

<div class="top-row ps-3 navbar bg-white">
    <div class="container-fluid d-flex align-items-center">
        <a class="navbar-brand d-flex align-items-center text-decoration-none py-1" href="">
            <img src="images/essl_logo.webp" alt="eSSL" style="height: 28px; max-width: 85px; object-fit: contain;" class="me-2" />
            <span class="fw-bold text-dark" style="font-size: 1.15rem; letter-spacing: -0.2px;">ECL eBios</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- Operations Section -->
        <div class="px-3 pt-3 pb-1 text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
            Operations
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146z"/>
                </svg> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="employees">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                    <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.736 9.486l-.853-.426A4.975 4.975 0 0 0 3 10.5c-1.424 0-2.477.72-3.003 1.583A.5.5 0 0 0 .5 13h5.45c-.092-.323-.15-.662-.15-1.016 0-.86.257-1.68.836-2.498ZM2 5.5a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0Z"/>
                </svg> Employees & Miners
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="attendance">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                </svg> Daily Attendance
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shifts">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                </svg> Shifts & Rosters
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="subareas">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v2H6V3a2 2 0 0 1 2-2zm3 4V3a3 3 0 1 0-6 0v2H3.5A1.5 1.5 0 0 0 2 6.5v7A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 12.5 5H11zm-7 2h8a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-6a.5.5 0 0 1 .5-.5z"/>
                </svg> Colliery Units
            </NavLink>
        </div>

        @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin || UserSession.IsUnitAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="devices">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                        <path d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H5z"/>
                        <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg> Biometric Devices
                </NavLink>
            </div>
        }

        @if (UserSession.IsSuperAdmin)
        {
            <!-- Master Admin Setup Section (SuperAdmin Only) -->
            <div class="px-3 pt-3 pb-1 text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                Main Admin Setup
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="areas">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                        <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022zM6 8.694 1 10.36V15h5V8.694zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.709l-7 3.5V15z"/>
                    </svg> Mining Areas
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="nav-icon me-2" viewBox="0 0 16 16">
                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                    </svg> User Accounts
                </NavLink>
            </div>
        }

        @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin || UserSession.IsUnitAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="audit-logs">
                    <i class="bi bi-clock-history me-2 text-info"></i> Audit Trail
                </NavLink>
            </div>
        }

        <div class="nav-item px-3 border-top border-secondary border-opacity-25 mt-2 pt-2">
            <NavLink class="nav-link" href="security/2fa">
                <i class="bi bi-shield-lock me-2 text-warning"></i> Security &amp; 2FA
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
