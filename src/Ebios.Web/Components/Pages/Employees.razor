    private async Task HandleBulkBlacklistFileUpload(InputFileChangeEventArgs e)
    {
        bulkModalError = null;
        bulkModalSuccess = null;
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var rawLines = content.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(l => l.Trim())
                .Where(l => !string.IsNullOrWhiteSpace(l))
                .ToList();

            if (!rawLines.Any())
            {
                bulkModalError = "Uploaded file is empty.";
                return;
            }

            int codeColIndex = 0;
            int serialColIndex = -1;
            int actionColIndex = -1;
            int startIndex = 0;

            // Check if first line contains header columns
            string firstLine = rawLines[0];
            var headerCols = firstLine.Split(new[] { ',', '\t', ';' }).Select(c => c.Trim().ToLowerInvariant()).ToList();
            if (headerCols.Any(c => c.Contains("code") || c.Contains("emp") || c.Contains("id")))
            {
                startIndex = 1;
                for (int i = 0; i < headerCols.Count; i++)
                {
                    if (headerCols[i].Contains("code") || headerCols[i].Contains("emp") || headerCols[i].Contains("id"))
                    {
                        codeColIndex = i;
                    }
                    else if (headerCols[i].Contains("serial") || headerCols[i].Contains("device") || headerCols[i].Contains("gate") || headerCols[i].Contains("machine"))
                    {
                        serialColIndex = i;
                    }
                    else if (headerCols[i].Contains("action") || headerCols[i].Contains("block") || headerCols[i].Contains("status") || headerCols[i].Contains("type"))
                    {
                        actionColIndex = i;
                    }
                }
            }

            var extractedTriplets = new List<string>();
            for (int i = startIndex; i < rawLines.Count; i++)
            {
                var cols = rawLines[i].Split(new[] { ',', '\t', ';' }).Select(c => c.Trim().Trim('"', '\'')).ToList();
                string code = cols.Count > codeColIndex ? cols[codeColIndex] : "";
                string serial = "ALL";
                if (serialColIndex >= 0 && cols.Count > serialColIndex && !string.IsNullOrWhiteSpace(cols[serialColIndex]))
                {
                    serial = cols[serialColIndex];
                }
                else if (cols.Count > 1 && codeColIndex == 0 && actionColIndex != 1)
                {
                    serial = cols[1];
                }

                string action = "Block";
                if (actionColIndex >= 0 && cols.Count > actionColIndex && !string.IsNullOrWhiteSpace(cols[actionColIndex]))
                {
                    action = cols[actionColIndex];
                }
                else if (cols.Count > 2)
                {
                    action = cols[2];
                }

                if (!string.IsNullOrWhiteSpace(code))
                {
                    extractedTriplets.Add($"{code}, {serial}, {action}");
                }
            }

            var finalTriplets = extractedTriplets.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (!finalTriplets.Any())
            {
                bulkModalError = "No valid records found in the uploaded file.";
                return;
            }

            bulkEmpCodesInput = string.Join("\n", finalTriplets);
            bulkModalSuccess = $"Successfully loaded {finalTriplets.Count} record(s) from {file.Name}.";
        }
        catch (Exception ex)
        {
            bulkModalError = "Failed to parse file: " + ex.Message;
        }
    }

    private async Task ExecuteBulkBlacklistAsync()
    {
        bulkModalError = null;
        bulkModalSuccess = null;

        var rawLines = bulkEmpCodesInput.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        var entries = new List<BulkBlockEntryDto>();

        foreach (var line in rawLines)
        {
            var parts = line.Split(new[] { ',', '\t', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim())
                .ToList();

            if (parts.Count >= 3)
            {
                entries.Add(new BulkBlockEntryDto(parts[0], parts[1], parts[2]));
            }
            else if (parts.Count == 2)
            {
                if (parts[1].Equals("Block", StringComparison.OrdinalIgnoreCase) || parts[1].Equals("Unblock", StringComparison.OrdinalIgnoreCase))
                {
                    entries.Add(new BulkBlockEntryDto(parts[0], "ALL", parts[1]));
                }
                else
                {
                    entries.Add(new BulkBlockEntryDto(parts[0], parts[1], "Block"));
                }
            }
            else if (parts.Count == 1)
            {
                var spaceParts = parts[0].Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (spaceParts.Length >= 3)
                {
                    entries.Add(new BulkBlockEntryDto(spaceParts[0], spaceParts[1], spaceParts[2]));
                }
                else if (spaceParts.Length == 2)
                {
                    if (spaceParts[1].Equals("Block", StringComparison.OrdinalIgnoreCase) || spaceParts[1].Equals("Unblock", StringComparison.OrdinalIgnoreCase))
                    {
                        entries.Add(new BulkBlockEntryDto(spaceParts[0], "ALL", spaceParts[1]));
                    }
                    else
                    {
                        entries.Add(new BulkBlockEntryDto(spaceParts[0], spaceParts[1], "Block"));
                    }
                }
                else
                {
                    entries.Add(new BulkBlockEntryDto(parts[0], "ALL", "Block"));
                }
            }
        }

        if (!entries.Any())
        {
            bulkModalError = "Please enter or upload at least one valid Employee Code.";
            return;
        }

        isBulkProcessing = true;
        try
        {
            var (successCount, totalCount, msg) = await EmployeeService.BulkBlacklistEmployeesAsync(
                entries,
                bulkActionReason,
                UserSession.CurrentAreaId,
                UserSession.CurrentSubAreaId
            );

            if (successCount > 0)
            {
                successMessage = msg;
                await LoadDataAsync();
                CloseBulkBlacklistModal();
            }
            else
            {
                bulkModalError = msg;
            }
        }
        catch (Exception ex)
        {
            bulkModalError = "Bulk action error: " + ex.Message;
        }
        finally
        {
            isBulkProcessing = false;
        }
    }

