                                            </td>
                                            <td>
                                                <div>@log.DeviceName</div>
                                                <small class="font-monospace text-muted">SN: @log.SerialNumber</small>
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(log.VerificationType) ? "Biometric" : log.VerificationType)
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    ● @log.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEmployeeLogsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmployeeDto> employees = new();
    private List<SubAreaDto> allSubAreas = new();
    private bool isLoading = true;

    // Filters
    private string searchTerm = string.Empty;
    private int subAreaFilter = 0;

    // Alerts
    private string? successMessage;
    private string? errorMessage;

    // Modal state: Onboard
    private bool showCreateModal = false;
    private bool isSaving = false;
    private string? modalError;
    private int newSubAreaId = 0;
    private string newEmpCode = string.Empty;
    private string newFullName = string.Empty;
    private string newDesignation = "General Mazdoor";
    private List<int> newAdditionalSubAreaIds = new();
    private int selectedAdditionalSubAreaId = 0;

    // Modal state: Edit & Transfer
    private bool showEditModal = false;
    private string? editModalError;
    private int editingEmployeeId = 0;
    private string editEmpCode = string.Empty;
    private string editFullName = string.Empty;
    private string editDesignation = "General Mazdoor";
    private int editSubAreaId = 0;
    private List<int> editAdditionalSubAreaIds = new();
    private int editSelectedAdditionalSubAreaId = 0;

    // Modal state: View Worker Logs
    private bool showLogsModal = false;
    private bool isLoadingLogs = false;
    private string logsWorkerEmpCode = string.Empty;
    private string logsWorkerName = string.Empty;
    private List<AttendanceLogDto> employeeLogs = new();

    private async Task OpenEmployeeLogsModal(EmployeeDto emp)
    {
        logsWorkerEmpCode = emp.EmpCode;
        logsWorkerName = emp.FullName;
        showLogsModal = true;
        isLoadingLogs = true;
        employeeLogs.Clear();
        try
        {
            employeeLogs = await AttendanceService.GetEmployeeLogsAsync(emp.EmpCode);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load punch logs for {emp.FullName}: {ex.Message}";
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private void CloseEmployeeLogsModal()
    {
        showLogsModal = false;
        employeeLogs.Clear();
    }

    protected override async Task OnInitializedAsync()
    {
        UserSession.OnChange += StateHasChangedCustom;
        await LoadDataAsync();
    }

    public void Dispose()
    {
        UserSession.OnChange -= StateHasChangedCustom;
    }

    private async void StateHasChangedCustom()
    {
        await InvokeAsync(async () =>
        {
            subAreaFilter = 0;
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private IEnumerable<SubAreaDto> PermittedSubAreas
    {
        get
        {
            if (UserSession.IsSuperAdmin)
            {
                return allSubAreas;
            }
            if (UserSession.IsAreaAdmin && UserSession.CurrentUser?.AreaId.HasValue == true)
            {
                return allSubAreas.Where(s => s.AreaId == UserSession.CurrentUser.AreaId.Value);
            }
            if (UserSession.IsUnitAdmin && UserSession.CurrentUser?.SubAreaId.HasValue == true)
            {
                return allSubAreas.Where(s => s.Id == UserSession.CurrentUser.SubAreaId.Value);
            }
            return allSubAreas;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allSubAreas = await AreaService.GetSubAreasAsync();

            int? areaIdScope = UserSession.IsAreaAdmin ? UserSession.CurrentUser?.AreaId : null;
            int? subAreaIdScope = UserSession.IsUnitAdmin ? UserSession.CurrentUser?.SubAreaId : null;

            employees = await EmployeeService.GetEmployeesAsync(areaIdScope, subAreaIdScope);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load employees: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<EmployeeDto> FilteredEmployees
    {
        get
        {
            var query = employees.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(e =>
                    e.EmpCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.Designation.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.SubAreaName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (subAreaFilter > 0)
            {
                query = query.Where(e => e.SubAreaId == subAreaFilter);
            }

            return query;
        }
    }

    private void AddLocationToNewWorker()
    {
        if (selectedAdditionalSubAreaId > 0 && selectedAdditionalSubAreaId != newSubAreaId && !newAdditionalSubAreaIds.Contains(selectedAdditionalSubAreaId))
        {
            newAdditionalSubAreaIds.Add(selectedAdditionalSubAreaId);
            selectedAdditionalSubAreaId = 0;
        }
    }

    private void RemoveLocationFromNewWorker(int subAreaId)
    {
        newAdditionalSubAreaIds.Remove(subAreaId);
    }

    private void AddLocationToEditWorker()
    {
        if (editSelectedAdditionalSubAreaId > 0 && editSelectedAdditionalSubAreaId != editSubAreaId && !editAdditionalSubAreaIds.Contains(editSelectedAdditionalSubAreaId))
        {
            editAdditionalSubAreaIds.Add(editSelectedAdditionalSubAreaId);
            editSelectedAdditionalSubAreaId = 0;
        }
    }

    private void RemoveLocationFromEditWorker(int subAreaId)
    {
        editAdditionalSubAreaIds.Remove(subAreaId);
    }

    private void OpenCreateModal()
    {
        newSubAreaId = PermittedSubAreas.FirstOrDefault()?.Id ?? 0;
        newEmpCode = string.Empty;
        newFullName = string.Empty;
        newDesignation = "General Mazdoor";
        newAdditionalSubAreaIds = new();
        selectedAdditionalSubAreaId = 0;
        modalError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        newAdditionalSubAreaIds = new();
        selectedAdditionalSubAreaId = 0;
        modalError = null;
    }

    private void OpenEditModal(EmployeeDto emp)
    {
        editingEmployeeId = emp.Id;
        editEmpCode = emp.EmpCode;
        editFullName = emp.FullName;
        editDesignation = emp.Designation;
        editSubAreaId = emp.SubAreaId;
        editAdditionalSubAreaIds = emp.AdditionalSubAreaIds.ToList();
        editSelectedAdditionalSubAreaId = 0;
        editModalError = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editAdditionalSubAreaIds = new();
        editSelectedAdditionalSubAreaId = 0;
        editModalError = null;
    }

    private async Task SaveEmployeeAsync()
    {
        modalError = null;

        if (newSubAreaId <= 0)
        {
            modalError = "Please select a Colliery Unit.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newEmpCode))
        {
            modalError = "Employee ID is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newFullName))
        {
            modalError = "Full Name is required.";
            return;
        }

        isSaving = true;
        try
        {
            var dto = new CreateEmployeeDto(newEmpCode.Trim().ToUpperInvariant(), newFullName.Trim(), newDesignation, newSubAreaId, newAdditionalSubAreaIds);
            var result = await EmployeeService.CreateEmployeeAsync(dto);
            successMessage = $"Worker '{result.FullName}' ({result.EmpCode}) onboarded successfully. Biometric registration: {(result.IsSyncedToEbios ? "Synced" : "Queued")}.";
            showCreateModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveEditEmployeeAsync()
    {
        editModalError = null;

        if (string.IsNullOrWhiteSpace(editFullName))
        {
            editModalError = "Full Name is required.";
            return;
        }

        if (editSubAreaId <= 0)
        {
            editModalError = "Please select a Colliery Unit.";
            return;
        }

        isSaving = true;
        try
        {
            var dto = new UpdateEmployeeDto(editFullName.Trim(), editDesignation, editSubAreaId, editAdditionalSubAreaIds);
            int? areaIdScope = UserSession.IsAreaAdmin ? UserSession.CurrentUser?.AreaId : null;

            var (success, msg) = await EmployeeService.UpdateEmployeeAsync(editingEmployeeId, dto, areaIdScope);

            if (success)
            {
                successMessage = msg;
                showEditModal = false;
                await LoadDataAsync();
            }
            else
            {
                editModalError = msg;
            }
        }
        catch (Exception ex)
        {
            editModalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SyncEmployeeAsync(EmployeeDto emp)
    {
        try
        {
            var synced = await EmployeeService.SyncEmployeeAsync(emp.Id);
            if (synced)
            {
                successMessage = $"Worker {emp.EmpCode} synchronized to biometric turnstiles.";
                await LoadDataAsync();
            }
            else
            {
                errorMessage = $"Failed to synchronize worker {emp.EmpCode}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Sync error: {ex.Message}";
        }
    }

    private async Task ToggleStatusAsync(EmployeeDto emp)
    {
        try
        {
            var toggled = await EmployeeService.ToggleEmployeeStatusAsync(emp.Id);
            if (toggled)
            {
                successMessage = $"Worker {emp.EmpCode} status updated.";
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update worker status: {ex.Message}";
        }
    }
}
