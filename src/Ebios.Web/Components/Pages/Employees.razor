    private async Task DeleteCurrentDesignationAsync(string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        var (success, msg) = await EmployeeService.DeleteDesignationAsync(title);
        if (success)
        {
            successMessage = msg;
            availableDesignations = await EmployeeService.GetDesignationsAsync();
            if (newDesignationSelection == title)
                newDesignationSelection = availableDesignations.FirstOrDefault() ?? "Colliery Worker";
            if (editDesignationSelection == title)
                editDesignationSelection = availableDesignations.FirstOrDefault() ?? "Colliery Worker";
        }
        else
        {
            errorMessage = msg;
        }
    }
