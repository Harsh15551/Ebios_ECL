            return;
        }

        if (string.IsNullOrWhiteSpace(newEmpCode))
        {
            modalError = "Employee ID is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newFullName))
        {
            modalError = "Full Name is required.";
            return;
        }

        string resolvedDesignation = !string.IsNullOrWhiteSpace(newDesignationSelection) ? newDesignationSelection : "Colliery Worker";

        isSaving = true;
        try
        {
            var dto = new CreateEmployeeDto(newEmpCode.Trim().ToUpperInvariant(), newFullName.Trim(), resolvedDesignation, newSubAreaId, newAdditionalSubAreaIds, newIsHigherAuthority);
