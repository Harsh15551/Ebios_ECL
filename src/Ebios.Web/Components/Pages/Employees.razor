@page "/employees"
@rendermode InteractiveServer
@implements IDisposable
@inject IEmployeeService EmployeeService
@inject IAreaService AreaService
@inject IAttendanceService AttendanceService
@inject IBiometricFormService BiometricService
@inject UserSessionService UserSession
@inject IJSRuntime JS

<PageTitle>ECL - Colliery Workers & Personnel</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-1">Colliery Workers & Personnel</h2>
            @if (UserSession.IsSuperAdmin)
            {
                <span class="badge bg-danger">ECL HQ Scope (All Areas)</span>
            }
            else if (UserSession.IsAreaAdmin)
            {
                <span class="badge bg-primary">@(UserSession.CurrentUser?.AreaName) Jurisdiction</span>
            }
            else if (UserSession.IsUnitAdmin)
            {
                <span class="badge bg-info text-dark">@(UserSession.CurrentUser?.SubAreaName) Unit Only</span>
            }

            @if (!UserSession.CanManageEmployees)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-eye"></i> View-Only Access</span>
            }
        </div>
        <p class="text-muted mb-0">
            @if (!UserSession.CanManageEmployees)
            {
                <span class="text-danger fw-semibold">Read-Only Mode: You have viewing access to colliery personnel. Adding, editing, and deactivating workers are restricted by ECL Admin.</span>
            }
            else if (UserSession.IsSuperAdmin)
            {
                <span>Main Administrator: You have full authority to view, onboard, edit, and transfer workers across all 13 Mining Areas.</span>
            }
            else if (UserSession.IsAreaAdmin)
            {
                <span>Area Personnel Manager: You have authority to manage workers and transfer them between colliery units inside <strong>@(UserSession.CurrentUser?.AreaName)</strong>.</span>
            }
            else
            {
                <span>Unit Personnel Manager: Access strictly restricted to workers in <strong>@(UserSession.CurrentUser?.SubAreaName)</strong>.</span>
            }
        </p>
    </div>
    @if (UserSession.CanManageEmployees)
    {
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info" @onclick="OpenBulkBiometricModal" title="Upload Biometric Particulars (CSV) or Photos (ZIP)">
                <i class="bi bi-person-bounding-box me-1"></i> Bulk Biometric Upload
            </button>
            <button class="btn btn-outline-dark" @onclick="OpenBulkPrintModal" title="Bulk print or export biometric registration forms">
                <i class="bi bi-printer me-1"></i> Bulk Print Forms
            </button>
            <button class="btn btn-outline-success" @onclick="OpenBulkEmployeeModal">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Bulk Worker Onboard
            </button>
            <button class="btn btn-outline-danger" @onclick="OpenBulkBlacklistModal" title="Control turnstile gate access in bulk (Lock / Unlock)">
                <i class="bi bi-shield-lock me-1"></i> Turnstile Access Control
            </button>
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Onboard Worker
            </button>
        </div>
    }
    else
    {
        <span class="badge bg-secondary p-2">
            <i class="bi bi-lock-fill me-1"></i> View-Only Mode
        </span>
    }
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success:</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Error:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

@if (flaggedPunchesCount > 0)
{
    <div class="alert alert-warning shadow-sm d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <span class="fs-4 me-3">🚩</span>
            <div>
                <strong class="d-block">@flaggedPunchesCount Flagged Unregistered Worker Punches Detected</strong>
                <span class="small text-muted">Workers have swiped at colliery turnstiles without an active employee master profile. Onboard them or import bulk forms to resolve.</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/attendance" class="btn btn-warning btn-sm fw-bold px-3">
                Review in Attendance
            </a>
            @if (UserSession.CanManageEmployees)
            {
                <button class="btn btn-primary btn-sm fw-bold px-3" @onclick="OpenCreateModal">
                    Onboard Worker
                </button>
            }
        </div>
    </div>
}

<!-- Filters Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </span>
                    <input type="text" class="form-control" placeholder="Search by name, ID, or designation..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>

            <div class="col-12 col-md-3">
                <select class="form-select" @bind="subAreaFilter">
                    <option value="0">All Permitted Units (@PermittedSubAreas.Count() Units)</option>
                    @foreach (var sub in PermittedSubAreas)
                    {
                        <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode) - @sub.AreaName</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <select class="form-select" @bind="authorityFilter">
                    <option value="all">All Personnel Categories</option>
                    <option value="authorities">👔 Higher Authorities / Executives</option>
                    <option value="workers">Colliery Workers Only</option>
                </select>
            </div>

            <div class="col-12 col-md-2 text-md-end text-muted small">
                <strong>@FilteredEmployees.Count()</strong> of <strong>@employees.Count</strong> Workers
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading workers for your jurisdiction...</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Employee ID</th>
                        <th>Full Name</th>
                        <th>Designation / Role</th>
                        <th>Colliery Unit & Area</th>
                        <th style="width: 150px;">Biometric Sync</th>
                        <th style="width: 200px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredEmployees.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No employees found in this jurisdiction matching your filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in FilteredEmployees)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary font-monospace fs-6">@emp.EmpCode</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    @emp.FullName
                                    @if (emp.IsHigherAuthority)
                                    {
                                        <span class="badge ms-1" style="background-color: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; font-size: 0.72rem;" title="Higher Authority / Executive: single-punch attendance permitted">
                                            👔 Higher Authority
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@emp.Designation</span>
                                </td>
                                <td>
                                    @if (emp.SubAreaId > 0)
                                    {
                                        <div class="fw-semibold text-dark">@emp.SubAreaName</div>
                                        @if (emp.AdditionalSubAreaNames.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var addName in emp.AdditionalSubAreaNames)
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 0.72rem;">
                                                        + @addName
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <small class="text-muted">@emp.AreaName</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning" title="No colliery unit assigned. Click Edit or use Bulk Worker Onboard to assign location.">
                                            <i class="bi bi-geo-alt-fill me-1"></i> Location Not Assigned
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (emp.IsSyncedToEbios)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            ● Synced
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            ● Sync Failed
                                        </span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <!-- View Logs Button (Always accessible) -->
                                    <button class="btn btn-sm btn-outline-info me-1" @onclick="@(() => OpenEmployeeLogsModal(emp))" title="View worker punch logs">
                                        📋 Logs
                                    </button>

                                    @if (UserSession.CanManageEmployees)
                                    {
                                        @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
                                        {
                                            <button class="btn btn-sm me-1" 
                                                    style="@(emp.IsHigherAuthority ? "color: #5b21b6; background-color: #ede9fe; border: 1px solid #c4b5fd;" : "color: #4b5563; background-color: #f3f4f6; border: 1px solid #d1d5db;")"
                                                    @onclick="@(() => ToggleHigherAuthorityStatusAsync(emp))" 
                                                    title="@(emp.IsHigherAuthority ? "Revoke Higher Authority status" : "Map as Higher Authority / Executive")">
                                                @(emp.IsHigherAuthority ? "👔 Authority" : "👔 Set Authority")
                                            </button>
                                        }

                                        <!-- Biometric Registration Template Form (ECL & WEBEL) -->
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => OpenBiometricFormModal(emp))" title="Biometric Registration Template (ECL & WEBEL)">
                                            📋 Biometric Form
                                        </button>

                                        <!-- Edit Button (Permitted for SuperAdmin and Respected Area Admin) -->
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="@(() => OpenEditModal(emp))" title="Edit details or transfer location">
                                            ✏️ Edit
                                        </button>

                                        <!-- Turnstile Machine Access Control Button -->
                                        <button class="btn btn-sm btn-outline-dark me-1" @onclick="@(() => OpenDeviceAccessModal(emp))" title="Control physical turnstile machine access per machine">
                                            🔒 Gate Access
                                        </button>

                                        <!-- Re-sync Button (Only shown if sync failed) -->
                                        @if (!emp.IsSyncedToEbios)
                                        {
                                            <button class="btn btn-sm btn-outline-danger me-1" @onclick="@(() => SyncEmployeeAsync(emp))" title="Retry push worker to eBios">
                                                Retry Sync
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">View Only</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal 1: Onboard Employee -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Onboard Colliery Worker</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small">@modalError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assigned Colliery Unit <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="newSubAreaId">
                            <option value="0">-- Select Permitted Colliery Unit --</option>
                            @foreach (var sub in PermittedSubAreas)
                            {
                                <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode) - @sub.AreaName</option>
                            }
                        </select>
                        @if (UserSession.IsAreaAdmin)
                        {
                            <small class="text-muted">Showing only Colliery Units inside your jurisdiction: @(UserSession.CurrentUser?.AreaName).</small>
                        }
                    </div>

                    <!-- Additional Multi-Location Assignment -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Additional Authorized Units (Multi-Location)
                        </label>
                        <div class="input-group mb-2">
                            <select class="form-select" @bind="selectedAdditionalSubAreaId">
                                <option value="0">-- Select Additional Unit to Authorize --</option>
                                @foreach (var sub in PermittedSubAreas.Where(s => s.Id != newSubAreaId && !newAdditionalSubAreaIds.Contains(s.Id)))
                                {
                                    <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode)</option>
                                }
                            </select>
                            <button class="btn btn-outline-primary" type="button" @onclick="AddLocationToNewWorker">
                                ➕ Add Location
                            </button>
                        </div>
                        @if (newAdditionalSubAreaIds.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 align-items-center p-2 bg-light rounded border">
                                <span class="small text-muted me-1">Authorized Units:</span>
                                @foreach (var subId in newAdditionalSubAreaIds)
                                {
                                    var unit = allSubAreas.FirstOrDefault(s => s.Id == subId);
                                    if (unit != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center py-1 px-2">
                                            @unit.SubAreaName
                                            <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="@(() => RemoveLocationFromNewWorker(subId))"></button>
                                        </span>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Employee ID / Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-monospace" placeholder="e.g. ECL-8041" @bind="newEmpCode" />
                        <small class="text-muted">Unique official Coal India / ECL employee number.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Sunil Kumar Soren" @bind="newFullName" />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Designation / Role</label>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 small" @onclick="ToggleInlineCreateAdd">
                                @(showInlineCreateAdd ? "✕ Cancel" : "➕ Add New")
                            </button>
                        </div>

                        @if (showInlineCreateAdd)
                        {
                            <div class="card card-body bg-light p-2 mb-2 border shadow-sm">
                                <div class="d-flex gap-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="Type new designation..." @bind="inlineCreateTitle" @onkeydown="HandleInlineCreateKeyDown" />
                                    <button type="button" class="btn btn-sm btn-primary text-nowrap" @onclick="SaveInlineCreateDesignationAsync">Add to List</button>
                                </div>
                                @if (!string.IsNullOrEmpty(inlineCreateError))
                                {
                                    <div class="text-danger small mt-1">@inlineCreateError</div>
                                }
                            </div>
                        }

                        <div class="input-group">
                            <select class="form-select" @bind="newDesignationSelection">
                                @foreach (var d in availableDesignations)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            @if (availableDesignations.Count > 1 && !string.IsNullOrWhiteSpace(newDesignationSelection))
                            {
                                <button class="btn btn-outline-danger btn-sm" type="button" title="Delete '@newDesignationSelection' from list" @onclick="@(() => DeleteCurrentDesignationAsync(newDesignationSelection))">
                                    🗑️
                                </button>
                            }
                        </div>
                    </div>

                    @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
                    {
                        <div class="form-check form-switch mb-3 p-2 bg-light rounded border">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="newHigherAuthSwitch" @bind="newIsHigherAuthority" />
                            <label class="form-check-label fw-semibold" for="newHigherAuthSwitch">
                                👔 Higher Authority / Executive
                            </label>
                            <div class="form-text text-muted" style="font-size: 0.78rem;">
                                Single-punch attendance permitted; exempt from shift timing and late marks.
                            </div>
                        </div>
                    }

                    <div class="alert alert-light border py-2 small text-muted mb-0">
                        <strong>Biometric Auto-Enrollment:</strong> This worker will be automatically registered with turnstiles at this colliery.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateModal" disabled="@isSaving">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEmployeeAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Onboarding...</span>
                        }
                        else
                        {
                            <span>Save & Register Worker</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Employee Punch Logs Modal -->
@if (showLogsModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">📋 Worker Punch Logs: @logsWorkerName</h5>
                        <small class="text-muted font-monospace">Employee Code: @logsWorkerEmpCode</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseEmployeeLogsModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingLogs)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                            <span class="ms-2 text-muted">Loading punch records...</span>
                        </div>
                    }
                    else if (!employeeLogs.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <div>No punch records found for this worker yet.</div>
                            <small>Punches will appear here automatically when the worker swipes on a biometric turnstile.</small>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Punch Time</th>
                                        <th>Direction</th>
                                        <th>Colliery Unit / Area</th>
                                        <th>Terminal Name</th>
                                        <th>Verification</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in employeeLogs)
                                    {
                                        <tr>
                                            <td class="font-monospace">
                                                <strong>@log.LogDate.ToString("HH:mm:ss")</strong>
                                                <small class="text-muted ms-1">@log.LogDate.ToString("dd MMM yyyy")</small>
                                            </td>
                                            <td>
                                                @if (log.Direction.Equals("IN", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        ↓ IN
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        ↑ OUT
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div>@log.SubAreaName</div>
                                                <small class="text-muted">@log.AreaName</small>
                                            </td>
                                            <td>
                                                <div>@log.DeviceName</div>
                                                <small class="font-monospace text-muted">SN: @log.SerialNumber</small>
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(log.VerificationType) ? "Biometric" : log.VerificationType)
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    ● @log.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEmployeeLogsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal 2: Edit Worker & Transfer Location -->
@if (showEditModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Worker & Location Transfer</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(editModalError))
                    {
                        <div class="alert alert-danger py-2 small">@editModalError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Employee ID (Fixed)</label>
                        <div>
                            <span class="badge bg-dark font-monospace fs-6 px-3 py-2">@editEmpCode</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="editFullName" />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Designation / Role</label>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 small" @onclick="ToggleInlineEditAdd">
                                @(showInlineEditAdd ? "✕ Cancel" : "➕ Add New")
                            </button>
                        </div>

                        @if (showInlineEditAdd)
                        {
                            <div class="card card-body bg-light p-2 mb-2 border shadow-sm">
                                <div class="d-flex gap-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="Type new designation..." @bind="inlineEditTitle" @onkeydown="HandleInlineEditKeyDown" />
                                    <button type="button" class="btn btn-sm btn-primary text-nowrap" @onclick="SaveInlineEditDesignationAsync">Add to List</button>
                                </div>
                                @if (!string.IsNullOrEmpty(inlineEditError))
                                {
                                    <div class="text-danger small mt-1">@inlineEditError</div>
                                }
                            </div>
                        }

                        <div class="input-group">
                            <select class="form-select" @bind="editDesignationSelection">
                                @foreach (var d in availableDesignations)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            @if (availableDesignations.Count > 1 && !string.IsNullOrWhiteSpace(editDesignationSelection))
                            {
                                <button class="btn btn-outline-danger btn-sm" type="button" title="Delete '@editDesignationSelection' from list" @onclick="@(() => DeleteCurrentDesignationAsync(editDesignationSelection))">
                                    🗑️
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Assigned Colliery Unit / Location <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" @bind="editSubAreaId">
                            @if (editSubAreaId == 0)
                            {
                                <option value="0">-- Select Permitted Colliery Unit --</option>
                            }
                            @foreach (var sub in PermittedSubAreas)
                            {
                                <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode) - @sub.AreaName</option>
                            }
                        </select>
                        <div class="form-text small">
                            @if (UserSession.IsSuperAdmin)
                            {
                                <span>Main Admin Authority: You can transfer this worker to any colliery unit across ECL.</span>
                            }
                            else if (UserSession.IsAreaAdmin)
                            {
                                <span>Area Admin Authority: You can transfer this worker between units inside <strong>@(UserSession.CurrentUser?.AreaName)</strong>.</span>
                            }
                        </div>
                    </div>

                    <!-- Additional Multi-Location Assignment (Edit) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Additional Authorized Units (Multi-Location)
                        </label>
                        <div class="input-group mb-2">
                            <select class="form-select" @bind="editSelectedAdditionalSubAreaId">
                                <option value="0">-- Select Additional Unit to Authorize --</option>
                                @foreach (var sub in PermittedSubAreas.Where(s => s.Id != editSubAreaId && !editAdditionalSubAreaIds.Contains(s.Id)))
                                {
                                    <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode)</option>
                                }
                            </select>
                            <button class="btn btn-outline-primary" type="button" @onclick="AddLocationToEditWorker">
                                ➕ Add Location
                            </button>
                        </div>
                        @if (editAdditionalSubAreaIds.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 align-items-center p-2 bg-light rounded border">
                                <span class="small text-muted me-1">Authorized Units:</span>
                                @foreach (var subId in editAdditionalSubAreaIds)
                                {
                                    var unit = allSubAreas.FirstOrDefault(s => s.Id == subId);
                                    if (unit != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center py-1 px-2">
                                            @unit.SubAreaName
                                            <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="@(() => RemoveLocationFromEditWorker(subId))"></button>
                                        </span>
                                    }
                                }
                            </div>
                        }
                    </div>

                    @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
                    {
                        <div class="form-check form-switch mb-3 p-2 bg-light rounded border">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="editHigherAuthSwitch" @bind="editIsHigherAuthority" />
                            <label class="form-check-label fw-semibold" for="editHigherAuthSwitch">
                                👔 Higher Authority / Executive
                            </label>
                            <div class="form-text text-muted" style="font-size: 0.78rem;">
                                Single-punch attendance permitted; exempt from shift timing and late marks.
                            </div>
                        </div>
                    }

                    <div class="alert alert-info py-2 small mb-0">
                        <strong>Automatic Biometric Re-Sync:</strong> Saving will update this worker's location in the central eBios biometric system so gate attendance readers immediately update.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditModal" disabled="@isSaving">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditEmployeeAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving & Re-syncing...</span>
                        }
                        else
                        {
                            <span>Save Changes & Sync</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Employee Punch Logs Modal -->
@if (showLogsModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">📋 Worker Punch Logs: @logsWorkerName</h5>
                        <small class="text-muted font-monospace">Employee Code: @logsWorkerEmpCode</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseEmployeeLogsModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingLogs)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                            <span class="ms-2 text-muted">Loading punch records...</span>
                        </div>
                    }
                    else if (!employeeLogs.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <div>No punch records found for this worker yet.</div>
                            <small>Punches will appear here automatically when the worker swipes on a biometric turnstile.</small>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Punch Time</th>
                                        <th>Direction</th>
                                        <th>Colliery Unit / Area</th>
                                        <th>Terminal Name</th>
                                        <th>Verification</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in employeeLogs)
                                    {
                                        <tr>
                                            <td class="font-monospace">
                                                <strong>@log.LogDate.ToString("HH:mm:ss")</strong>
                                                <small class="text-muted ms-1">@log.LogDate.ToString("dd MMM yyyy")</small>
                                            </td>
                                            <td>
                                                @if (log.Direction.Equals("IN", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        ↓ IN
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        ↑ OUT
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div>@log.SubAreaName</div>
                                                <small class="text-muted">@log.AreaName</small>
                                            </td>
                                            <td>
                                                <div>@log.DeviceName</div>
                                                <small class="font-monospace text-muted">SN: @log.SerialNumber</small>
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(log.VerificationType) ? "Biometric" : log.VerificationType)
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    ● @log.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEmployeeLogsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

