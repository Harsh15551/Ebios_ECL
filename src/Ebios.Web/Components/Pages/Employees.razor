    private IEnumerable<SubAreaDto> PermittedSubAreas
    {
        get
        {
            if (UserSession.IsSuperAdmin)
            {
                return allSubAreas;
            }
            if (UserSession.IsAreaAdmin && UserSession.CurrentUser?.AreaId.HasValue == true)
            {
                return allSubAreas.Where(s => s.AreaId == UserSession.CurrentUser.AreaId.Value);
            }
            if (UserSession.IsUnitAdmin && UserSession.CurrentUser?.SubAreaId.HasValue == true)
            {
                return allSubAreas.Where(s => s.Id == UserSession.CurrentUser.SubAreaId.Value);
            }
            return allSubAreas;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allSubAreas = await AreaService.GetSubAreasAsync(UserSession.CurrentAreaId);

            int? areaIdScope = UserSession.IsAreaAdmin ? UserSession.CurrentUser?.AreaId : null;
            int? subAreaIdScope = UserSession.IsUnitAdmin ? UserSession.CurrentUser?.SubAreaId : null;

            employees = await EmployeeService.GetEmployeesAsync(areaIdScope, subAreaIdScope);
            availableDesignations = await EmployeeService.GetDesignationsAsync();
            flaggedPunchesCount = await AttendanceService.GetFlaggedCountAsync(areaIdScope, subAreaIdScope);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load employees: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<EmployeeDto> FilteredEmployees
    {
        get
        {
            var query = employees.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(e =>
                    e.EmpCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.Designation.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.SubAreaName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (subAreaFilter > 0)
            {
                query = query.Where(e => e.SubAreaId == subAreaFilter);
            }

            if (authorityFilter == "authorities")
            {
                query = query.Where(e => e.IsHigherAuthority);
            }
            else if (authorityFilter == "workers")
            {
                query = query.Where(e => !e.IsHigherAuthority);
            }

            return query;
        }
    }

