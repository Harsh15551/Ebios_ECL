        }
    }

    private async Task UnblockAllMachinesForTargetAsync()
    {
        if (targetDeviceEmp == null) return;
        isDeviceProcessing = true;
        deviceModalError = null;
        deviceModalSuccess = null;
        try
        {
            var (success, msg) = await EmployeeService.BlockAllDevicesForWorkerAsync(targetDeviceEmp.Id, false);
            if (success)
            {
                deviceModalSuccess = msg;
                targetWorkerDevices = await EmployeeService.GetWorkerDevicesAsync(targetDeviceEmp.Id);
                await LoadDataAsync();
                targetDeviceEmp = employees.FirstOrDefault(e => e.Id == targetDeviceEmp.Id) ?? targetDeviceEmp;
            }
            else
            {
                deviceModalError = msg;
            }
        }
        catch (Exception ex)
        {
            deviceModalError = "Error allowing turnstiles: " + ex.Message;
        }
        finally
        {
            isDeviceProcessing = false;
        }
    }

    // Inline Designation Actions
    private void ToggleInlineCreateAdd()
    {
        showInlineCreateAdd = !showInlineCreateAdd;
        inlineCreateTitle = string.Empty;
        inlineCreateError = null;
    }

    private async Task HandleInlineCreateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveInlineCreateDesignationAsync();
        }
    }

    private async Task SaveInlineCreateDesignationAsync()
    {
        inlineCreateError = null;
        if (string.IsNullOrWhiteSpace(inlineCreateTitle))
        {
            inlineCreateError = "Please enter a designation title.";
            return;
        }

        string clean = inlineCreateTitle.Trim();
        var (success, msg) = await EmployeeService.AddDesignationAsync(clean);
        if (success || msg.Contains("already exists", StringComparison.OrdinalIgnoreCase))
        {
            availableDesignations = await EmployeeService.GetDesignationsAsync();
            newDesignationSelection = clean;
            showInlineCreateAdd = false;
            inlineCreateTitle = string.Empty;
        }
        else
        {
            inlineCreateError = msg;
        }
    }

