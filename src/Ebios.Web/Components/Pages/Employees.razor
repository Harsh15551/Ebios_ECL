    private async Task ExecuteBulkEmployeeUploadAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkEmployeeCsvText))
        {
            bulkEmpModalError = "Please select a file or paste CSV data.";
            return;
        }

        isBulkEmployeeSaving = true;
        bulkEmpModalError = null;
        bulkEmpModalSuccess = null;

        try
        {
            var lines = bulkEmployeeCsvText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            var entries = new List<BulkEmployeeEntryDto>();

            for (int i = 0; i < lines.Length; i++)
            {
                string line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var parts = line.Split(new[] { ',', '\t', ';' });
                if (parts.Length < 2) continue;

                string code = parts[0].Trim();
                if (code.Equals("EmpCode", StringComparison.OrdinalIgnoreCase) || code.Equals("Worker", StringComparison.OrdinalIgnoreCase))
                {
                    continue; // Skip header
                }

                string name = parts.Length > 1 ? parts[1].Trim() : code;
                string desig = parts.Length > 2 && !string.IsNullOrWhiteSpace(parts[2]) ? parts[2].Trim() : "Colliery Worker";
                string unit = parts.Length > 3 ? parts[3].Trim() : string.Empty;
                bool isAuth = parts.Length > 4 && (parts[4].Trim().Equals("Yes", StringComparison.OrdinalIgnoreCase) || parts[4].Trim().Equals("True", StringComparison.OrdinalIgnoreCase));

                entries.Add(new BulkEmployeeEntryDto(code, name, desig, unit, isAuth));
            }

            if (entries.Count == 0)
            {
                bulkEmpModalError = "No valid employee records found.";
                return;
            }

            var (successCount, totalCount, errors) = await EmployeeService.BulkCreateEmployeesAsync(entries, UserSession.CurrentSubAreaId);
            if (errors.Count == 0)
            {
                successMessage = $"Successfully onboarded/updated {successCount} worker(s). Past punches automatically linked!";
                CloseBulkEmployeeModal();
                await LoadDataAsync();
            }
            else
            {
                bulkEmpModalSuccess = $"Onboarded {successCount} of {totalCount} worker(s).";
                bulkEmpModalError = $"{errors.Count} error(s): " + string.Join(" | ", errors.Take(3));
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            bulkEmpModalError = "Bulk onboard error: " + ex.Message;
        }
        finally
        {
            isBulkEmployeeSaving = false;
        }
    }

