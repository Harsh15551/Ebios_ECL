<!-- Modal: Per-Machine Turnstile Gate Access Control -->
@if (showDeviceAccessModal && targetDeviceEmp != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-shield-lock text-warning me-2"></i> Turnstile Gate Access Control
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeviceAccessModal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Worker Details Banner -->
                    <div class="card border-0 bg-light p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">@targetDeviceEmp.FullName</h5>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary font-monospace">@targetDeviceEmp.EmpCode</span>
                                    <span class="badge bg-secondary">@targetDeviceEmp.Designation</span>
                                    <span class="text-muted small">@targetDeviceEmp.SubAreaName (@targetDeviceEmp.AreaName)</span>
                                </div>
                            </div>
                            <div class="text-end">
                                @if (targetDeviceEmp.IsBlacklisted)
                                {
                                    <span class="badge bg-danger fs-6">🚫 Blacklisted</span>
                                }
                                else if (!targetDeviceEmp.IsActive)
                                {
                                    <span class="badge bg-danger fs-6">🔒 Fully Blocked</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(targetDeviceEmp.BlockedDeviceSerials))
                                {
                                    <span class="badge bg-warning text-dark fs-6">⚠️ Partial Gate Access</span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6">● All Gates Active</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(deviceModalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@deviceModalError</div>
                    }
                    @if (!string.IsNullOrEmpty(deviceModalSuccess))
                    {
                        <div class="alert alert-success py-2 small mb-3">@deviceModalSuccess</div>
                    }

                    <!-- Global Bulk Controls for this Worker -->
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 border rounded bg-white">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i> Control physical biometric turnstile machines across assigned collieries.
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-danger" @onclick="BlockAllMachinesForTargetAsync" disabled="@isDeviceProcessing">
                                🚫 Block All Machines
                            </button>
                            <button class="btn btn-sm btn-outline-success" @onclick="UnblockAllMachinesForTargetAsync" disabled="@isDeviceProcessing">
                                ✅ Allow All Machines
                            </button>
                        </div>
                    </div>

                    <!-- Machine Access List -->
                    @if (isLoadingDevices)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="text-muted small mt-2">Checking turnstile machines...</div>
                        </div>
                    }
                    else if (!targetWorkerDevices.Any())
                    {
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-1"></i> No biometric devices are currently registered in this worker's assigned colliery units (@targetDeviceEmp.SubAreaName).
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive border rounded">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Turnstile Machine</th>
                                        <th>Serial / Hardware ID</th>
                                        <th>Colliery / Unit</th>
                                        <th>Direction</th>
                                        <th>Access Status</th>
                                        <th class="text-end">Hardware Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dev in targetWorkerDevices)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@dev.DeviceName</div>
                                            </td>
                                            <td>
                                                <span class="font-monospace small bg-light p-1 rounded border">@dev.SerialNumber</span>
                                            </td>
                                            <td>
                                                <span class="small text-muted">@dev.SubAreaName</span>
                                            </td>
                                            <td>
                                                <span class="badge @(dev.Direction == "IN" ? "bg-info" : dev.Direction == "OUT" ? "bg-warning text-dark" : "bg-secondary")">
                                                    @dev.Direction
                                                </span>
                                            </td>
                                            <td>
                                                @if (dev.IsBlocked)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        🔒 Blocked (Denied)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        ● Active (Allowed)
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (dev.IsBlocked)
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => ToggleDeviceAccessAsync(dev.SerialNumber, false)" disabled="@isDeviceProcessing">
                                                        <i class="bi bi-unlock"></i> Allow Access
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleDeviceAccessAsync(dev.SerialNumber, true)" disabled="@isDeviceProcessing">
                                                        <i class="bi bi-lock"></i> Block Machine
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    @if (isDeviceProcessing)
                    {
                        <div class="me-auto text-primary small d-flex align-items-center">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Communicating with turnstile hardware...</span>
                        </div>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeviceAccessModal" disabled="@isDeviceProcessing">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Biometric Registration Modals -->
<BiometricFormModal IsOpen="@isBiometricModalOpen" Model="@activeBiometricForm" CurrentUser="@(UserSession.CurrentUser?.Username ?? "APM")" OnClosed="CloseBiometricFormModal" />
<BulkBiometricModal IsOpen="@isBulkBiometricModalOpen" CurrentUser="@(UserSession.CurrentUser?.Username ?? "APM")" OnClosed="@(() => isBulkBiometricModalOpen = false)" />
<BulkPrintBiometricModal IsOpen="@isBulkPrintModalOpen" OnClosed="@(() => isBulkPrintModalOpen = false)" />

@code {
    private List<EmployeeDto> employees = new();
    private List<SubAreaDto> allSubAreas = new();
    private bool isLoading = true;

    // Biometric Registration Modals State
    private bool isBiometricModalOpen = false;
    private BiometricFormDto? activeBiometricForm;
    private bool isBulkBiometricModalOpen = false;
    private bool isBulkPrintModalOpen = false;

    private async Task OpenBiometricFormModal(EmployeeDto emp)
    {
        try
        {
            activeBiometricForm = await BiometricService.GetOrCreateFormByEmpCodeAsync(emp.EmpCode);
            isBiometricModalOpen = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load biometric form for worker {emp.EmpCode}: {ex.Message}";
        }
    }

    private void CloseBiometricFormModal()
    {
        isBiometricModalOpen = false;
        activeBiometricForm = null;
    }

    private void OpenBulkBiometricModal()
    {
        isBulkBiometricModalOpen = true;
    }

    private void OpenBulkPrintModal()
    {
        isBulkPrintModalOpen = true;
    }

    // Filters
    private string searchTerm = string.Empty;
    private int subAreaFilter = 0;
    private string authorityFilter = "all";
    private int flaggedPunchesCount = 0;

    // Alerts
    private string? successMessage;
    private string? errorMessage;

    // Modal state: Onboard
    private bool showCreateModal = false;
    private bool isSaving = false;
    private string? modalError;
    private int newSubAreaId = 0;
    private string newEmpCode = string.Empty;
    private string newFullName = string.Empty;
    private bool newIsHigherAuthority = false;
    private List<int> newAdditionalSubAreaIds = new();
    private int selectedAdditionalSubAreaId = 0;

    // Modal state: Edit & Transfer
    private bool showEditModal = false;
    private string? editModalError;
    private int editingEmployeeId = 0;
    private string editEmpCode = string.Empty;
    private string editFullName = string.Empty;
    private bool editIsHigherAuthority = false;
    private int editSubAreaId = 0;
    private List<int> editAdditionalSubAreaIds = new();
    private int editSelectedAdditionalSubAreaId = 0;

    // Designation Master state
    private List<string> availableDesignations = new();
    private string newDesignationSelection = "Colliery Worker";
    private string editDesignationSelection = "Colliery Worker";

    // Inline Add state for Create Modal
    private bool showInlineCreateAdd = false;
    private string inlineCreateTitle = string.Empty;
    private string? inlineCreateError;

    // Inline Add state for Edit Modal
