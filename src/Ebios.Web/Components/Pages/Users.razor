@page "/users"
@rendermode InteractiveServer
@inject IUserService UserService
@inject IAreaService AreaService
@inject UserSessionService UserSession

<PageTitle>ECL - User & Role Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Personnel & Access Control</h2>
        <p class="text-muted mb-0">Role-based access management for ECL HQ Administrators, Area Personnel Managers (APMs), and Unit Managers (UPMs)</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Add New User
    </button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success:</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Error:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </span>
                    <input type="text" class="form-control" placeholder="Search by name, username, or email..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>

            <div class="col-12 col-md-4">
                <select class="form-select" @bind="roleFilter">
                    <option value="0">All Roles</option>
                    <option value="1">SuperAdmin (ECL HQ)</option>
                    <option value="2">Area Personnel Manager (APM)</option>
                    <option value="3">Unit Personnel Manager (UPM)</option>
                </select>
            </div>

            <div class="col-12 col-md-2 text-md-end text-muted small">
                <strong>@FilteredUsers.Count()</strong> Users
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading ECL personnel records...</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Username</th>
                        <th>Full Name & Email</th>
                        <th style="width: 150px;">Role</th>
                        <th>Assigned Jurisdiction</th>
                        <th style="width: 200px;">Access Permissions</th>
                        <th style="width: 90px;">Status</th>
                        <th style="width: 120px;">Created On</th>
                        <th style="width: 150px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No users match your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@user.Username</span>
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">
                                                <i class="bi bi-shield-check me-1"></i> 2FA Active
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@user.FullName</div>
                                    <small class="text-muted">@user.Email</small>
                                </td>
                                <td>
                                    @switch (user.Role)
                                    {
                                        case UserRole.SuperAdmin:
                                            <span class="badge bg-danger">SuperAdmin</span>
                                            break;
                                        case UserRole.AreaPersonnelManager:
                                            <span class="badge bg-primary">APM</span>
                                            break;
                                        case UserRole.UnitPersonnelManager:
                                            <span class="badge bg-info text-dark">UPM</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (user.Role == UserRole.SuperAdmin)
                                    {
                                        <span class="text-muted">ECL HQ (All 13 Areas)</span>
                                    }
                                    else if (user.Role == UserRole.AreaPersonnelManager)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            🏢 @(user.AreaName ?? "Unassigned")
                                        </span>
                                    }
                                    else if (user.Role == UserRole.UnitPersonnelManager)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            ⛏️ @(user.SubAreaName ?? "Unassigned Unit")
                                        </span>
                                        @if (!string.IsNullOrEmpty(user.AreaName))
                                        {
                                            <small class="text-muted ms-1">(@user.AreaName)</small>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (user.Role == UserRole.SuperAdmin)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">Full HQ Authority</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge @(user.CanManageEmployees ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-dark border border-warning") text-start" style="font-size: 0.72rem;">
                                                👤 Workers: @(user.CanManageEmployees ? "Add / Edit / Deactivate" : "View Only")
                                            </span>
                                            <span class="badge @(user.CanManageShifts ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-dark border border-warning") text-start" style="font-size: 0.72rem;">
                                                ⏰ Shifts: @(user.CanManageShifts ? "Master & Rosters" : "View Only")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @user.CreatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (user.TwoFactorEnabled)
                                    {
                                        <button class="btn btn-sm btn-outline-warning me-1" 
                                                @onclick="@(() => OpenReset2FaModal(user))" 
                                                title="Reset Two-Factor Authentication if user lost phone or codes">
                                            <i class="bi bi-shield-x me-1"></i> Reset 2FA
                                        </button>
                                    }
                                    @if (user.Role != UserRole.SuperAdmin)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1" 
                                                @onclick="@(() => OpenPermissionsModal(user))" 
                                                title="Configure permissions for this manager">
                                            🛡️ Permissions
                                        </button>
                                    }
                                    <button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                            @onclick="@(() => ToggleStatusAsync(user))"
                                            disabled="@(user.Username == "admin")"
                                            title="@(user.Username == "admin" ? "Default SuperAdmin cannot be disabled" : (user.IsActive ? "Disable User" : "Enable User"))">
                                        @(user.IsActive ? "Disable" : "Enable")
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Create User Modal -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add ECL Personnel Account</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2 small">@modalError</div>
                    }

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. apm_salanpur" @bind="newUsername" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Temporary Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="••••••••" @bind="newPassword" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Rajesh Kumar" @bind="newFullName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" placeholder="e.g. rajesh.kumar@ecl.gov.in" @bind="newEmail" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assigned Role <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="newRole" @bind:after="OnRoleChanged">
                            <option value="@UserRole.AreaPersonnelManager">Area Personnel Manager (APM)</option>
                            <option value="@UserRole.UnitPersonnelManager">Unit Personnel Manager (UPM)</option>
                            <option value="@UserRole.SuperAdmin">SuperAdmin (ECL HQ)</option>
                        </select>
                    </div>

                    @if (newRole == UserRole.AreaPersonnelManager)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Assigned Mining Area <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newAreaId">
                                <option value="0">-- Select Mining Area --</option>
                                @foreach (var area in areas)
                                {
                                    <option value="@area.Id">@area.AreaName (@area.AreaCode)</option>
                                }
                            </select>
                            <small class="text-muted">APMs manage all Sub-Areas and Units under this selected Area.</small>
                        </div>
                    }
                    else if (newRole == UserRole.UnitPersonnelManager)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Assigned Sub-Area / Colliery Unit <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newSubAreaId">
                                <option value="0">-- Select Sub-Area Unit --</option>
                                @foreach (var sub in subAreas)
                                {
                                    <option value="@sub.Id">@sub.SubAreaName (@sub.SubAreaCode) - @sub.AreaName</option>
                                }
                            </select>
                            <small class="text-muted">UPMs have restricted access strictly to their single assigned Sub-Area.</small>
                        </div>
                    }

                    @if (newRole != UserRole.SuperAdmin)
                    {
                        <div class="card bg-light border-0 p-3 mb-3">
                            <label class="form-label fw-bold mb-2 small text-uppercase text-secondary">Initial Permission Rights</label>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="newPermEmp" @bind="newCanManageEmployees" />
                                <label class="form-check-label fw-semibold small" for="newPermEmp">
                                    Can Manage Workers (Add, Edit, Deactivate)
                                </label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="newPermShifts" @bind="newCanManageShifts" />
                                <label class="form-check-label fw-semibold small" for="newPermShifts">
                                    Can Manage Shifts & Rosters (Master Shifts, Bulk Upload, Assign)
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateModal" disabled="@isSaving">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUserAsync" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Creating Account...</span>
                        }
                        else
                        {
                            <span>Create Account</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit User Permissions Modal -->
@if (showPermissionsModal && permissionUser != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">Manager Access Control & Permissions</h5>
                        <small class="text-muted">User: <strong>@permissionUser.FullName</strong> (@permissionUser.Username) — @permissionUser.Role</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="ClosePermissionsModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(permissionsModalError))
                    {
                        <div class="alert alert-danger py-2 small">@permissionsModalError</div>
                    }

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> As SuperAdmin, you can grant or restrict editing privileges for this personnel manager. Unchecked options enforce <strong>View-Only</strong> access.
                    </div>

                    <!-- Worker / Employee Management Permission -->
                    <div class="card mb-3 p-3 border @(editCanManageEmployees ? "border-success bg-success-subtle bg-opacity-10" : "border-secondary")">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchEmp" @bind="editCanManageEmployees" />
                            <label class="form-check-label fw-bold" for="switchEmp">
                                👤 Colliery Workers & Personnel
                            </label>
                        </div>
                        <div class="small text-muted ms-4">
                            @if (editCanManageEmployees)
                            {
                                <span class="text-success fw-semibold">✓ Full Access:</span> <span>Can onboard new workers, edit employee details/locations, retry eBios sync, and activate/deactivate accounts.</span>
                            }
                            else
                            {
                                <span class="text-warning-emphasis fw-semibold">🔒 View Only:</span> <span>Can view worker lists and audit logs. Adding, editing, and deactivating are locked.</span>
                            }
                        </div>
                    </div>

                    <!-- Shift & Roster Management Permission -->
                    <div class="card p-3 border @(editCanManageShifts ? "border-success bg-success-subtle bg-opacity-10" : "border-secondary")">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchShifts" @bind="editCanManageShifts" />
                            <label class="form-check-label fw-bold" for="switchShifts">
                                ⏰ Master Shifts & Daily Worker Rosters
                            </label>
                        </div>
                        <div class="small text-muted ms-4">
                            @if (editCanManageShifts)
                            {
                                <span class="text-success fw-semibold">✓ Full Access:</span> <span>Can create master shifts, perform bulk Excel/CSV roster uploads, and assign/change daily shift schedules.</span>
                            }
                            else
                            {
                                <span class="text-warning-emphasis fw-semibold">🔒 View Only:</span> <span>Can view master shift timings and daily worker schedules. Shift editing and roster imports are locked.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClosePermissionsModal" disabled="@isSavingPermissions">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SavePermissionsAsync" disabled="@isSavingPermissions">
                        @if (isSavingPermissions)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving Permissions...</span>
                        }
                        else
                        {
                            <span>Save Permissions</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reset 2FA Confirmation Modal -->
@if (showReset2FaModal && targetUserFor2FaReset != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-dark py-3">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-shield-x me-2"></i> Reset Two-Factor Authentication
                    </h5>
                    <button type="button" class="btn-close" @onclick="@(() => showReset2FaModal = false)" disabled="@isResetting2Fa"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2">Are you sure you want to reset 2FA for this user?</p>
                    <div class="p-3 bg-light rounded border mb-3">
                        <div><strong>User:</strong> @targetUserFor2FaReset.FullName (<code>@targetUserFor2FaReset.Username</code>)</div>
                        <div class="text-muted small"><strong>Role:</strong> @targetUserFor2FaReset.Role</div>
                    </div>
                    <div class="alert alert-warning py-2 small mb-0">
                        <strong>Security Effect:</strong> The user will immediately be able to log in using their password only. Their previous authenticator pairing and recovery codes will be permanently invalidated.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => showReset2FaModal = false)" disabled="@isResetting2Fa">Cancel</button>
                    <button type="button" class="btn btn-warning btn-sm fw-semibold" @onclick="ConfirmReset2FaAsync" disabled="@isResetting2Fa">
                        @if (isResetting2Fa)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Resetting 2FA...</span>
                        }
                        else
                        {
                            <span>Yes, Reset 2FA</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> users = new();
    private List<AreaDto> areas = new();
    private List<SubAreaDto> subAreas = new();
    private bool isLoading = true;

    // Reset 2FA State
    private bool showReset2FaModal = false;
    private bool isResetting2Fa = false;
    private UserDto? targetUserFor2FaReset;

    private void OpenReset2FaModal(UserDto user)
    {
        targetUserFor2FaReset = user;
        showReset2FaModal = true;
    }

    private async Task ConfirmReset2FaAsync()
    {
        if (targetUserFor2FaReset == null) return;

        isResetting2Fa = true;
        try
        {
            var (success, msg) = await UserService.AdminResetTwoFactorAsync(targetUserFor2FaReset.Id);
            if (success)
            {
                successMessage = msg;
                showReset2FaModal = false;
                await LoadDataAsync();
            }
            else
            {
                errorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to reset 2FA: {ex.Message}";
        }
        finally
        {
            isResetting2Fa = false;
        }
    }

    // Filters
    private string searchTerm = string.Empty;
    private int roleFilter = 0;

    // Alerts
    private string? successMessage;
    private string? errorMessage;

    // Modal state
    private bool showCreateModal = false;
    private bool isSaving = false;
    private string? modalError;
    private string newUsername = string.Empty;
    private string newFullName = string.Empty;
    private string newEmail = string.Empty;
    private string newPassword = string.Empty;
    private UserRole newRole = UserRole.AreaPersonnelManager;
    private int newAreaId = 0;
    private int newSubAreaId = 0;
    private bool newCanManageEmployees = true;
    private bool newCanManageShifts = true;

    // Permissions Modal state
    private bool showPermissionsModal = false;
    private bool isSavingPermissions = false;
    private string? permissionsModalError;
    private UserDto? permissionUser;
    private bool editCanManageEmployees = true;
    private bool editCanManageShifts = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            users = await UserService.GetUsersAsync();
            areas = await AreaService.GetAllAreasAsync();
            subAreas = await AreaService.GetSubAreasAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load personnel data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<UserDto> FilteredUsers
    {
        get
        {
            var query = users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(u =>
                    u.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (roleFilter > 0)
            {
                query = query.Where(u => (int)u.Role == roleFilter);
            }

            return query;
        }
    }

    private void OpenCreateModal()
    {
        newUsername = string.Empty;
        newFullName = string.Empty;
        newEmail = string.Empty;
        newPassword = string.Empty;
        newRole = UserRole.AreaPersonnelManager;
        newAreaId = areas.FirstOrDefault()?.Id ?? 0;
        newSubAreaId = subAreas.FirstOrDefault()?.Id ?? 0;
        newCanManageEmployees = true;
        newCanManageShifts = true;
        modalError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        modalError = null;
    }

    private void OnRoleChanged()
    {
        if (newRole == UserRole.AreaPersonnelManager && newAreaId == 0)
        {
            newAreaId = areas.FirstOrDefault()?.Id ?? 0;
        }
        else if (newRole == UserRole.UnitPersonnelManager && newSubAreaId == 0)
        {
            newSubAreaId = subAreas.FirstOrDefault()?.Id ?? 0;
        }
    }

    private void OpenPermissionsModal(UserDto user)
    {
        permissionUser = user;
        editCanManageEmployees = user.CanManageEmployees;
        editCanManageShifts = user.CanManageShifts;
        permissionsModalError = null;
        showPermissionsModal = true;
    }

    private void ClosePermissionsModal()
    {
        showPermissionsModal = false;
        permissionUser = null;
        permissionsModalError = null;
    }

    private async Task SavePermissionsAsync()
    {
        if (permissionUser == null) return;

        isSavingPermissions = true;
        permissionsModalError = null;
        try
        {
            var updateDto = new UpdateUserPermissionsDto(
                permissionUser.Id,
                editCanManageEmployees,
                editCanManageShifts
            );

            var ok = await UserService.UpdateUserPermissionsAsync(updateDto);
            if (ok)
            {
                successMessage = $"Permissions updated successfully for '{permissionUser.FullName}' ({permissionUser.Username}).";

                // If the updated user is currently logged in, update UserSession immediately
                if (UserSession.CurrentUser?.Id == permissionUser.Id)
                {
                    var updatedCurrentUser = await UserService.GetUserByIdAsync(permissionUser.Id);
                    if (updatedCurrentUser != null)
                    {
                        UserSession.SetCurrentUser(updatedCurrentUser);
                    }
                }

                showPermissionsModal = false;
                permissionUser = null;
                users = await UserService.GetUsersAsync();
            }
            else
            {
                permissionsModalError = "Failed to update user permissions.";
            }
        }
        catch (Exception ex)
        {
            permissionsModalError = ex.Message;
        }
        finally
        {
            isSavingPermissions = false;
        }
    }

    private async Task SaveUserAsync()
    {
        modalError = null;

        if (string.IsNullOrWhiteSpace(newUsername))
        {
            modalError = "Username is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newFullName))
        {
            modalError = "Full Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newEmail))
        {
            modalError = "Email is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 6)
        {
            modalError = "Password must be at least 6 characters.";
            return;
        }

        if (newRole == UserRole.AreaPersonnelManager && newAreaId <= 0)
        {
            modalError = "Please select an assigned Mining Area for this APM.";
            return;
        }

        if (newRole == UserRole.UnitPersonnelManager && newSubAreaId <= 0)
        {
            modalError = "Please select an assigned Sub-Area / Unit for this UPM.";
            return;
        }

        isSaving = true;
        try
        {
            var dto = new CreateUserDto(
                newUsername.Trim(),
                newFullName.Trim(),
                newEmail.Trim(),
                newPassword,
                newRole,
                newRole == UserRole.AreaPersonnelManager ? newAreaId : null,
                newRole == UserRole.UnitPersonnelManager ? newSubAreaId : null,
                newCanManageEmployees,
                newCanManageShifts
            );

            var created = await UserService.CreateUserAsync(dto);
            successMessage = $"User account '{created.Username}' ({created.Role}) created successfully.";
            showCreateModal = false;
            users = await UserService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleStatusAsync(UserDto user)
    {
        try
        {
            var toggled = await UserService.ToggleUserStatusAsync(user.Id);
            if (toggled)
            {
                successMessage = $"User '{user.Username}' status updated.";
                users = await UserService.GetUsersAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to change user status: {ex.Message}";
        }
    }
}

