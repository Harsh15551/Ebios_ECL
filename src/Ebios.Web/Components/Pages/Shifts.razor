    private async Task DownloadSampleRosterCsvAsync()
    {
        string dToday = selectedRosterDate.ToString("yyyy-MM-dd");
        string dTomorrow = selectedRosterDate.AddDays(1).ToString("yyyy-MM-dd");

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("EmpCode,Date,ShiftCode");
        sb.AppendLine($"ECL-7001,{dToday},Shift I");
        sb.AppendLine($"ECL-7002,{dToday},Shift II");
        sb.AppendLine($"ECL-7003,{dToday},Shift III");
        sb.AppendLine($"ECL-7001,{dTomorrow},Shift II");
        sb.AppendLine($"ECL-7002,{dTomorrow},Shift III");
        sb.AppendLine($"ECL-7003,{dTomorrow},Shift I");

        string base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
        string fileName = "ECL_Bulk_Roster_Template.csv";

        await JS.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.download = '{fileName}';
            link.href = 'data:text/csv;base64,{base64}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

    private async Task ProcessBulkRosterUploadAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkCsvText))
        {
            errorMessage = "Please enter or paste CSV lines, select a file, or click 'Fill Sample Data'.";
            return;
        }

        isBulkSaving = true;
        try
        {
            var lines = bulkCsvText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            var list = new List<AssignRosterDto>();

            foreach (var rawLine in lines)
            {
                var line = rawLine.Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                // Support comma, tab (from copying Excel cells), or semicolon
                char delimiter = line.Contains('\t') ? '\t' : (line.Contains(',') ? ',' : ';');
                var parts = line.Split(delimiter);

                if (parts.Length >= 3)
                {
                    string code = parts[0].Trim().Trim('"', '\'');
                    string datePart = parts[1].Trim().Trim('"', '\'');
                    string shift = parts[2].Trim().Trim('"', '\'');

                    // Skip header row
                    if (code.Equals("EmpCode", StringComparison.OrdinalIgnoreCase) || 
                        code.Equals("WorkerID", StringComparison.OrdinalIgnoreCase) ||
                        datePart.Equals("Date", StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    if (DateTime.TryParse(datePart, out var parsedDate))
                    {
                        list.Add(new AssignRosterDto(code, parsedDate, shift, UserSession.CurrentUser?.Username ?? "BulkImport"));
                    }
                }
            }

            if (!list.Any())
            {
                errorMessage = "No valid lines parsed. Make sure format is: EmpCode,YYYY-MM-DD,ShiftCode";
                return;
            }

            int imported = await RosterService.BulkAssignRosterAsync(
                list,
                performedByUserId: UserSession.CurrentUser?.Id,
                performedByUsername: UserSession.CurrentUser?.Username,
                performedByOfficerName: UserSession.CurrentUser?.FullName,
                performedByRole: UserSession.CurrentUser?.Role.ToString()
            );
            successMessage = $"Successfully imported {imported} shift assignments! Any existing attendance punches were retroactively recalculated.";
            showBulkUploadModal = false;
            await LoadRosterAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Import failed: " + ex.Message;
        }
        finally
        {
            isBulkSaving = false;
        }
    }

