    private void AutoCalculateDetectionWindows()
    {
        // Automatically calculate detection windows: [StartTime - 30m, StartTime + 90m]
        var startTs = shiftFormStartTime.ToTimeSpan();
        var endTs = shiftFormEndTime.ToTimeSpan();

        var inStart = startTs.Subtract(TimeSpan.FromMinutes(30));
        if (inStart < TimeSpan.Zero) inStart = inStart.Add(TimeSpan.FromHours(24));

        var inEnd = startTs.Add(TimeSpan.FromMinutes(90));
        if (inEnd >= TimeSpan.FromHours(24)) inEnd = inEnd.Subtract(TimeSpan.FromHours(24));

        shiftFormInStart = TimeOnly.FromTimeSpan(inStart);
        shiftFormInEnd = TimeOnly.FromTimeSpan(inEnd);
        shiftFormOutStart = new TimeOnly(0, 0);
        shiftFormOutEnd = new TimeOnly(23, 59);

        // Detect if night shift (End < Start)
        shiftFormIsNight = endTs < startTs;
    }

    private async Task SaveShiftAsync()
    {
        if (string.IsNullOrWhiteSpace(shiftFormCode) || string.IsNullOrWhiteSpace(shiftFormName))
        {
            errorMessage = "Please enter both Shift Code and Shift Description.";
            return;
        }

        isShiftSaving = true;
        try
        {
            if (editingShiftId > 0)
            {
                var updateDto = new UpdateShiftDto(
                    shiftFormCode,
                    shiftFormName,
                    shiftFormStartTime.ToTimeSpan(),
                    shiftFormEndTime.ToTimeSpan(),
                    shiftFormInStart.ToTimeSpan(),
                    shiftFormInEnd.ToTimeSpan(),
                    shiftFormOutStart.ToTimeSpan(),
                    shiftFormOutEnd.ToTimeSpan(),
                    shiftFormGrace,
                    shiftFormDuration,
                    shiftFormIsNight,
                    shiftFormIsActive
                );

                bool ok = await ShiftService.UpdateShiftAsync(
                    editingShiftId, 
                    updateDto,
                    performedByUserId: UserSession.CurrentUser?.Id,
                    performedByUsername: UserSession.CurrentUser?.Username,
                    performedByOfficerName: UserSession.CurrentUser?.FullName,
                    performedByRole: UserSession.CurrentUser?.Role.ToString()
                );
                if (ok)
                {
                    successMessage = $"Shift '{shiftFormCode}' updated successfully.";
                    showShiftModal = false;
                    await LoadShiftsAsync();
                }
                else
                {
                    errorMessage = "Failed to update shift. Please verify code uniqueness.";
                }
            }
            else
            {
                var createDto = new CreateShiftDto(
                    shiftFormCode,
                    shiftFormName,
                    shiftFormStartTime.ToTimeSpan(),
                    shiftFormEndTime.ToTimeSpan(),
                    shiftFormInStart.ToTimeSpan(),
                    shiftFormInEnd.ToTimeSpan(),
                    shiftFormOutStart.ToTimeSpan(),
                    shiftFormOutEnd.ToTimeSpan(),
                    shiftFormGrace,
                    shiftFormDuration,
                    shiftFormIsNight
                );

                bool ok = await ShiftService.CreateShiftAsync(
                    createDto,
                    performedByUserId: UserSession.CurrentUser?.Id,
                    performedByUsername: UserSession.CurrentUser?.Username,
                    performedByOfficerName: UserSession.CurrentUser?.FullName,
                    performedByRole: UserSession.CurrentUser?.Role.ToString()
                );
                if (ok)
                {
                    successMessage = $"Shift '{shiftFormCode}' created successfully.";
                    showShiftModal = false;
                    await LoadShiftsAsync();
                }
                else
                {
                    errorMessage = "Shift with this code already exists.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error saving shift: " + ex.Message;
        }
        finally
        {
            isShiftSaving = false;
        }
    }

