@page "/shifts"
@rendermode InteractiveServer
@inject IShiftService ShiftService
@inject IRosterService RosterService
@inject IEmployeeService EmployeeService
@inject IAreaService AreaService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>ECL - Shift Master & Worker Rosters</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-1">Shift Master & Worker Rosters</h2>
            <span class="badge bg-secondary">ECL Operations</span>
            @if (!UserSession.CanManageShifts)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-eye"></i> View-Only Access</span>
            }
        </div>
        <p class="text-muted mb-0">
            @if (!UserSession.CanManageShifts)
            {
                <span class="text-danger fw-semibold">Read-Only Mode: Shift creation, roster assignment, and bulk upload are locked by ECL Admin.</span>
            }
            else
            {
                <span>Pre-configured eBioServer master shifts and daily colliery roster schedules.</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (activeTab == "master")
        {
            @if (UserSession.CanManageShifts)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenCreateShiftModal">
                    <i class="bi bi-plus-circle me-1"></i> Add New Shift
                </button>
            }
            else
            {
                <span class="badge bg-secondary align-self-center py-2 px-3">
                    <i class="bi bi-lock-fill me-1"></i> View Only
                </span>
            }
        }
        else if (activeTab == "roster")
        {
            @if (UserSession.CanManageShifts)
            {
                <button class="btn btn-outline-primary btn-sm" @onclick="OpenBulkUploadModal">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Bulk Excel / CSV Import
                </button>
                <button class="btn btn-primary btn-sm" @onclick="OpenAssignModal">
                    <i class="bi bi-calendar-plus me-1"></i> Assign Shift
                </button>
            }
            else
            {
                <span class="badge bg-secondary align-self-center py-2 px-3">
                    <i class="bi bi-lock-fill me-1"></i> View Only
                </span>
            }
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success:</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Error:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-pills mb-4 border-bottom pb-2">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "master" ? "active" : "")" @onclick="@(() => activeTab = "master")">
            <i class="bi bi-clock-history me-1"></i> Master Shifts Catalog (@(shifts.Count))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "roster" ? "active" : "")" @onclick="@(() => SwitchToRosterTab())">
            <i class="bi bi-calendar-check me-1"></i> Daily Worker Rosters
        </button>
    </li>
</ul>

@if (activeTab == "master")
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">ECL Shift Master Catalog (eBioServer Standard)</h6>
            <span class="badge bg-light text-dark border">30-min Grace Period Permitted</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 130px;">Shift Code</th>
                        <th>Shift Description</th>
                        <th style="width: 140px;">Shift Hours</th>
                        <th style="width: 150px;">Reporting Window (IN)</th>
                        <th style="width: 110px;">Grace Period</th>
                        <th style="width: 90px;">Duration</th>
                        <th style="width: 110px;">Type</th>
                        <th class="text-end" style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!shifts.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No master shifts found. Please refresh or initialize.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in shifts)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark font-monospace fs-6">@s.ShiftCode</span>
                                    @if (!s.IsActive)
                                    {
                                        <span class="badge bg-danger ms-1">Inactive</span>
                                    }
                                </td>
                                <td class="fw-semibold">@s.ShiftName</td>
                                <td>
                                    <span class="text-primary fw-bold">@FormatTime(s.StartTime) – @FormatTime(s.EndTime)</span>
                                </td>
                                <td>
                                    <small class="text-muted font-monospace">@FormatTime(s.InWindowStart) – @FormatTime(s.InWindowEnd)</small>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@s.GraceMinutes mins</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@s.DurationHours hrs</span>
                                </td>
                                <td>
                                    @if (s.IsNightShift)
                                    {
                                        <span class="badge bg-warning text-dark">🌙 Night Shift</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">☀️ Day Shift</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (UserSession.CanManageShifts)
                                    {
                                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => OpenEditShiftModal(s))" title="Edit Shift">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">View Only</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (activeTab == "roster")
{
    <!-- Roster Date & Filter Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold">Roster Date</label>
                    <input type="date" class="form-control" @bind="selectedRosterDate" @bind:after="LoadRosterAsync" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold">Colliery / Sub-Area</label>
                    <select class="form-select" @bind="filterSubAreaId" @bind:after="LoadRosterAsync" disabled="@UserSession.IsUnitAdmin">
                        @if (!UserSession.IsUnitAdmin)
                        {
                            <option value="0">All Units</option>
                        }
                        @foreach (var sub in subAreas)
                        {
                            <option value="@sub.Id">@sub.SubAreaName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold">Search Worker</label>
                    <input type="text" class="form-control" placeholder="Search name or ID..." @bind="rosterSearchTerm" @bind:event="oninput" />
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="LoadRosterAsync" disabled="@isRosterLoading">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Roster Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">Shift Schedule for @selectedRosterDate.ToString("dd MMMM yyyy")</h6>
            <span class="badge bg-primary">@(FilteredRoster.Count) Scheduled</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Worker ID</th>
                        <th>Worker Name</th>
                        <th>Colliery / Unit</th>
                        <th>Assigned Shift</th>
                        <th>Assigned By</th>
                        <th>Schedule Date</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isRosterLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span> Loading shift roster...
                            </td>
                        </tr>
                    }
                    else if (!FilteredRoster.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                <div>No shift assignments found for this date.</div>
                                <small>Use <strong>"Assign Shift"</strong> or <strong>"Bulk Excel Import"</strong> to schedule workers.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in FilteredRoster)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">@r.EmpCode</td>
                                <td class="fw-semibold">@r.EmployeeName</td>
                                <td>@r.SubAreaName</td>
                                <td>
                                    <span class="badge bg-primary font-monospace">@r.ShiftCode</span>
                                    <span class="small text-muted ms-1">(@r.ShiftName)</span>
                                </td>
                                <td>
                                    <small class="text-muted">@(r.AssignedBy ?? "System")</small>
                                </td>
                                <td>@r.RosterDate.ToString("dd-MM-yyyy")</td>
                                <td class="text-end">
                                    @if (UserSession.CanManageShifts)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => OpenEditAssignModal(r))">
                                            <i class="bi bi-pencil-square"></i> Change
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">View Only</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Create / Edit Shift Modal -->
@if (showShiftModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        @(editingShiftId > 0 ? "Edit Master Shift" : "Create New Master Shift")
                    </h5>
                    <button type="button" class="btn-close" @onclick="@(() => showShiftModal = false)"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Shift Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. Fixed I, Shift V" @bind="shiftFormCode" disabled="@(editingShiftId > 0)" />
                            <small class="text-muted">Unique shift identifier</small>
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-semibold">Shift Description / Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. First Rotational Shift" @bind="shiftFormName" />
                        </div>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-primary">Shift Hours & Window Configuration</h6>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AutoCalculateDetectionWindows">
                                <i class="bi bi-magic me-1"></i> Auto-Calculate Windows
                            </button>
                        </div>

                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Start Time <span class="text-danger">*</span></label>
                                <input type="time" class="form-control" @bind="shiftFormStartTime" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">End Time <span class="text-danger">*</span></label>
                                <input type="time" class="form-control" @bind="shiftFormEndTime" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Duration (Hours)</label>
                                <input type="number" step="0.5" class="form-control" @bind="shiftFormDuration" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Grace Period (Mins)</label>
                                <input type="number" class="form-control" @bind="shiftFormGrace" />
                            </div>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="row g-3">
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Reporting Window Start (IN)</label>
                                <input type="time" class="form-control" @bind="shiftFormInStart" />
                                <small class="text-muted">Earliest punch (StartTime - 30m)</small>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Reporting Window End (IN)</label>
                                <input type="time" class="form-control" @bind="shiftFormInEnd" />
                                <small class="text-muted">Latest punch (StartTime + 90m)</small>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold">Exit Policy (OUT)</label>
                                <input type="text" class="form-control text-muted" value="Last punch of day (No restrictions)" disabled />
                                <small class="text-muted">Early exit evaluated against Shift End Time</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="nightShiftSwitch" @bind="shiftFormIsNight" />
                            <label class="form-check-label fw-semibold" for="nightShiftSwitch">
                                🌙 Night Shift (Crosses Midnight)
                            </label>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="activeShiftSwitch" @bind="shiftFormIsActive" />
                            <label class="form-check-label fw-semibold" for="activeShiftSwitch">
                                Active Shift
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="@(() => showShiftModal = false)">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveShiftAsync" disabled="@isShiftSaving">
                        @if (isShiftSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving Shift...</span>
                        }
                        else
                        {
                            <span>Save Shift</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Single Assign Modal -->
@if (showAssignModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Assign Shift to Worker</h5>
                    <button type="button" class="btn-close" @onclick="@(() => showAssignModal = false)"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Worker <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="assignEmpCode">
                            <option value="">-- Select Worker --</option>
                            @foreach (var emp in allEmployees)
                            {
                                <option value="@emp.EmpCode">@emp.EmpCode - @emp.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Roster Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="assignDate" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Shift <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="assignShiftCode">
                            <option value="">-- Select Shift --</option>
                            @foreach (var s in shifts.Where(x => x.IsActive))
                            {
                                <option value="@s.ShiftCode">@s.ShiftCode - @s.ShiftName (@FormatTime(s.StartTime) to @FormatTime(s.EndTime))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="@(() => showAssignModal = false)">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveShiftAssignmentAsync" disabled="@isAssignSaving">
                        @if (isAssignSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Shift</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bulk Upload Modal -->
@if (showBulkUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">Bulk Worker Roster Import (Excel / CSV)</h5>
                        <small class="text-muted">Schedule shifts for multiple employees using Excel copy-paste or file upload</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="@(() => showBulkUploadModal = false)"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold text-secondary">Step 1: Choose File OR Copy-Paste Data</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadSampleRosterCsvAsync" title="Download ECL_Bulk_Roster_Template.csv to your computer">
                                📥 Download Sample Template
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FillSampleData" title="Auto-fill sample data into the box below">
                                📋 Fill Sample Data
                            </button>
                        </div>
                    </div>

                    <!-- File Picker -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Upload CSV / Excel Text File</label>
                        <InputFile OnChange="HandleBulkFileSelectedAsync" class="form-control form-control-sm" accept=".csv,.txt" />
                        <small class="text-muted">Select <code>sample_bulk_roster.csv</code> from your workspace or any CSV export.</small>
                    </div>

                    <div class="alert alert-info py-2 small mb-3">
                        <strong>Expected Format:</strong> <code>EmpCode,Date(YYYY-MM-DD),ShiftCode</code><br />
                        <span class="text-muted">Supports comma (<code>,</code>), tab (from copying Excel cells), or semicolon (<code>;</code>) delimiters.</span>
                    </div>

                    <!-- Direct Textarea -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CSV / Excel Clipboard Data</label>
                        <textarea class="form-control font-monospace small" rows="8" placeholder="EmpCode,Date,ShiftCode&#10;ECL-7001,2026-11-04,Shift I&#10;ECL-7002,2026-11-04,Shift II&#10;ECL-7003,2026-11-04,Shift III" @bind="bulkCsvText"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="@(() => showBulkUploadModal = false)">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ProcessBulkRosterUploadAsync" disabled="@isBulkSaving">
                        @if (isBulkSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Importing & Recalculating...</span>
                        }
                        else
                        {
                            <span>Import Roster</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "master";
    private List<ShiftMasterDto> shifts = new();
    private List<EmployeeShiftRosterDto> rosters = new();
    private List<EmployeeDto> allEmployees = new();
    private List<SubAreaDto> subAreas = new();

    private DateTime selectedRosterDate = DateTime.Today;
    private int filterSubAreaId = 0;
    private string rosterSearchTerm = string.Empty;
    private bool isRosterLoading = false;

    // Shift Edit/Create Modal State
    private bool showShiftModal = false;
    private bool isShiftSaving = false;
    private int editingShiftId = 0;
    private string shiftFormCode = string.Empty;
    private string shiftFormName = string.Empty;
    private TimeOnly shiftFormStartTime = new(6, 0);
    private TimeOnly shiftFormEndTime = new(14, 0);
    private TimeOnly shiftFormInStart = new(4, 30);
    private TimeOnly shiftFormInEnd = new(9, 0);
    private TimeOnly shiftFormOutStart = new(13, 30);
    private TimeOnly shiftFormOutEnd = new(17, 0);
    private int shiftFormGrace = 30;
    private double shiftFormDuration = 8.0;
    private bool shiftFormIsNight = false;
    private bool shiftFormIsActive = true;

    // Modals
    private bool showAssignModal = false;
    private bool showBulkUploadModal = false;
    private bool isAssignSaving = false;
    private bool isBulkSaving = false;
    private string assignEmpCode = string.Empty;
    private DateTime assignDate = DateTime.Today;
    private string assignShiftCode = "Shift I";
    private string bulkCsvText = string.Empty;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadShiftsAsync();
        await LoadMetadataAsync();
    }

    private async Task LoadShiftsAsync()
    {
        shifts = await ShiftService.GetAllShiftsAsync();
    }

    private async Task LoadMetadataAsync()
    {
        allEmployees = await EmployeeService.GetEmployeesAsync(UserSession.CurrentAreaId, UserSession.CurrentSubAreaId);
        var subs = await AreaService.GetSubAreasAsync(UserSession.CurrentAreaId);
        if (UserSession.IsUnitAdmin && UserSession.CurrentSubAreaId.HasValue)
        {
            subAreas = subs.Where(s => s.Id == UserSession.CurrentSubAreaId.Value).ToList();
            filterSubAreaId = UserSession.CurrentSubAreaId.Value;
        }
        else
        {
            subAreas = subs;
        }
    }

    private async Task SwitchToRosterTab()
    {
        activeTab = "roster";
        await LoadRosterAsync();
    }

    private async Task LoadRosterAsync()
    {
        isRosterLoading = true;
        try
        {
            rosters = await RosterService.GetRosterAsync(
                selectedRosterDate, 
                areaId: UserSession.CurrentAreaId, 
                subAreaId: filterSubAreaId > 0 ? filterSubAreaId : UserSession.CurrentSubAreaId
            );
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load roster: " + ex.Message;
        }
        finally
        {
            isRosterLoading = false;
        }
    }

    private List<EmployeeShiftRosterDto> FilteredRoster => rosters
        .Where(r => string.IsNullOrWhiteSpace(rosterSearchTerm) ||
                    r.EmpCode.Contains(rosterSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    r.EmployeeName.Contains(rosterSearchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void OpenCreateShiftModal()
    {
        editingShiftId = 0;
        shiftFormCode = string.Empty;
        shiftFormName = string.Empty;
        shiftFormStartTime = new TimeOnly(6, 0);
        shiftFormEndTime = new TimeOnly(14, 0);
        shiftFormInStart = new TimeOnly(5, 30);
        shiftFormInEnd = new TimeOnly(7, 30);
        shiftFormOutStart = new TimeOnly(0, 0);
        shiftFormOutEnd = new TimeOnly(23, 59);
        shiftFormGrace = 30;
        shiftFormDuration = 8.0;
        shiftFormIsNight = false;
        shiftFormIsActive = true;
