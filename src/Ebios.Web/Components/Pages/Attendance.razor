    {
        isSftpTesting = true;
        sftpTestStatus = null;
        try
        {
            var (success, msg) = await SftpService.TestConnectionAsync();
            sftpTestStatusSuccess = success;
            sftpTestStatus = msg;
        }
        catch (Exception ex)
        {
            sftpTestStatusSuccess = false;
            sftpTestStatus = ex.Message;
        }
        finally
        {
            isSftpTesting = false;
        }
