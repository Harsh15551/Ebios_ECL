    private void OpenRegularizeModal(DailyMusterRollDto m)
    {
        selectedMusterRecord = m;
        regularizeInTime = m.FirstInTime.HasValue ? TimeOnly.FromDateTime(m.FirstInTime.Value) : null;
        regularizeOutTime = m.LastOutTime.HasValue ? TimeOnly.FromDateTime(m.LastOutTime.Value) : null;
        regularizeShiftCode = m.ShiftCode;

        if (!string.IsNullOrEmpty(m.CorrectionReason))
        {
            var presets = new[] {
                "Pithead turnstile power failure / Jam",
                "Biometric reader / Fingerprint sensor fault",
                "Deputed on official duty / ECL HQ movement",
                "Emergency mine rescue / Drainage deployment",
                "Shift handover delay approved by Colliery Manager"
            };
            if (presets.Contains(m.CorrectionReason))
            {
                regularizeSelectedReasonPreset = m.CorrectionReason;
                regularizeCustomReason = string.Empty;
            }
            else
            {
                regularizeSelectedReasonPreset = "Custom";
                regularizeCustomReason = m.CorrectionReason;
            }
        }
        else
        {
            regularizeSelectedReasonPreset = "Pithead turnstile power failure / Jam";
            regularizeCustomReason = string.Empty;
        }

        regularizeModalError = null;
        isRegularizeModalOpen = true;
    }

    private void CloseRegularizeModal()
    {
        isRegularizeModalOpen = false;
        selectedMusterRecord = null;
        regularizeModalError = null;
    }

    private async Task SaveRegularizationAsync()
    {
        if (selectedMusterRecord == null) return;

        string reason = regularizeSelectedReasonPreset == "Custom" ? regularizeCustomReason : regularizeSelectedReasonPreset;
        if (string.IsNullOrWhiteSpace(reason))
        {
            regularizeModalError = "Please specify a regularization reason.";
            return;
        }

        DateTime? inTime = regularizeInTime.HasValue 
            ? selectedMusterRecord.AttendanceDate.Date.Add(regularizeInTime.Value.ToTimeSpan()) 
            : null;

        DateTime? outTime = regularizeOutTime.HasValue 
            ? selectedMusterRecord.AttendanceDate.Date.Add(regularizeOutTime.Value.ToTimeSpan()) 
            : null;

        if (inTime.HasValue && outTime.HasValue && outTime < inTime)
        {
            outTime = outTime.Value.AddDays(1);
        }

        isRegularizing = true;
        regularizeModalError = null;

        try
        {
            var dto = new RegularizeAttendanceDto(
                selectedMusterRecord.Id,
                inTime,
                outTime,
                reason,
                UserSession.CurrentUser?.Username ?? "Admin",
                regularizeShiftCode
            );

            var (success, msg) = await AttendanceProcessingService.RegularizeAttendanceAsync(dto);
            if (success)
            {
                successMessage = msg;
                CloseRegularizeModal();
                await LoadMusterRollAsync();
            }
            else
            {
                regularizeModalError = msg;
            }
        }
        catch (Exception ex)
        {
            regularizeModalError = "Failed to save regularization: " + ex.Message;
        }
        finally
        {
            isRegularizing = false;
        }
    }

