        }
    }

    private List<DailyMusterRollDto> FilteredMusterRoll
    {
        get
        {
            var list = musterList.AsEnumerable();

            // 1. Shift Category Filter (Day vs Night)
            if (musterShiftCategory == "Day")
            {
                list = list.Where(m =>
                {
                    var s = masterShifts.FirstOrDefault(x => x.ShiftCode == m.ShiftCode);
                    return s == null || (!s.IsNightShift && s.EndTime >= s.StartTime);
                });
            }
            else if (musterShiftCategory == "Night")
            {
                list = list.Where(m =>
                {
                    var s = masterShifts.FirstOrDefault(x => x.ShiftCode == m.ShiftCode);
                    return s != null && (s.IsNightShift || s.EndTime < s.StartTime);
                });
            }

            // 2. Timing Anomaly Filter (Early In, Late In, Early Out, Late Out/OT, On-Time)
            if (musterTimingAnomaly == "EarlyIn")
            {
                list = list.Where(m => m.EarlyInMinutes > 0);
            }
            else if (musterTimingAnomaly == "LateIn")
            {
                list = list.Where(m => m.LateByMinutes > 0);
            }
            else if (musterTimingAnomaly == "EarlyOut")
            {
                list = list.Where(m => m.EarlyExitMinutes > 0);
            }
            else if (musterTimingAnomaly == "LateOut")
            {
                list = list.Where(m => m.OvertimeMinutes > 0 || (m.LastOutTime.HasValue && m.TotalWorkHours > 8.0));
            }
            else if (musterTimingAnomaly == "OnTime")
            {
                list = list.Where(m => m.LateByMinutes == 0 && m.EarlyInMinutes == 0 && m.EarlyExitMinutes == 0 && m.Status.StartsWith("Present"));
            }

            // 3. Flag Status Filter
            if (musterFlagFilter == "Flagged")
            {
                list = list.Where(m => m.IsFlagged);
            }
            else if (musterFlagFilter == "NonFlagged")
            {
                list = list.Where(m => !m.IsFlagged);
            }

            // 4. Search Term Filter
            if (!string.IsNullOrWhiteSpace(musterSearchTerm))
            {
                string s = musterSearchTerm.Trim();
                list = list.Where(m =>
                    m.EmpCode.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (m.EmployeeName != null && m.EmployeeName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.ShiftCode != null && m.ShiftCode.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.InDeviceName != null && m.InDeviceName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.OutDeviceName != null && m.OutDeviceName.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return list.OrderByDescending(m => m.AttendanceDate).ThenBy(m => m.EmpCode).ToList();
        }
    }

