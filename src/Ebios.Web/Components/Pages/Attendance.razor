    private async Task LoadMusterRollAsync()
    {
        UserSession.AttendanceFromDate = musterFromDate;
        UserSession.AttendanceToDate = musterToDate;
        filterFromDate = musterFromDate;
        filterToDate = musterToDate;

        isMusterLoading = true;
        try
        {
            var filter = new MusterRollFilterDto(
                FromDate: musterFromDate,
                ToDate: musterToDate,
                AreaId: UserSession.CurrentAreaId,
                SubAreaId: musterSubAreaId > 0 ? musterSubAreaId : UserSession.CurrentSubAreaId,
                ShiftCode: musterShiftCode,
                Status: musterStatus,
                SearchTerm: musterSearchTerm
            );

            musterList = await AttendanceProcessingService.GetMusterRollReportAsync(filter, UserSession.CurrentAreaId, UserSession.CurrentSubAreaId);
            musterKpis = await AttendanceProcessingService.GetMusterRollKpisAsync(musterFromDate, musterToDate, UserSession.CurrentAreaId, UserSession.CurrentSubAreaId);
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load Daily Muster Roll: " + ex.Message;
        }
        finally
        {
            isMusterLoading = false;
        }
    }

    private List<DailyMusterRollDto> FilteredMusterRoll
    {
        get
        {
            var list = musterList.AsEnumerable();

            if (musterFlagFilter == "Flagged")
            {
                list = list.Where(m => m.IsFlagged);
            }
            else if (musterFlagFilter == "NonFlagged")
            {
                list = list.Where(m => !m.IsFlagged);
            }

            if (!string.IsNullOrWhiteSpace(musterSearchTerm))
            {
                string s = musterSearchTerm.Trim();
                list = list.Where(m =>
                    m.EmpCode.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (m.EmployeeName != null && m.EmployeeName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.InDeviceName != null && m.InDeviceName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.OutDeviceName != null && m.OutDeviceName.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return list.ToList();
        }
    }

    private async Task RecalculateMusterRollAsync()
    {
        isRecalculating = true;
        try
        {
            int count = await AttendanceProcessingService.RecalculateDailyMusterRollAsync(musterFromDate, musterToDate, musterSubAreaId > 0 ? musterSubAreaId : null);
            successMessage = $"Successfully recalculated attendance report for {count} biometric punches between {musterFromDate:dd-MM-yyyy} and {musterToDate:dd-MM-yyyy}.";
            await LoadMusterRollAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Recalculation error: " + ex.Message;
        }
        finally
        {
            isRecalculating = false;
        }
    }

    private async Task ExportMusterRollToCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Date,Worker ID,Worker Name,Designation,Authority Status,Colliery Unit,Shift Code,First IN Time,IN Machine,Last OUT Time,OUT Machine,Duration (Hours),Early IN (Mins),Late (Mins),Early Exit (Mins),Overtime (Hours),Status,Regularized,Corrected By,Correction Reason,Remarks");

            foreach (var m in FilteredMusterRoll)
            {
                string inTime = m.FirstInTime.HasValue ? m.FirstInTime.Value.ToString("HH:mm:ss") : "";
                string inMach = (m.InDeviceName ?? m.InSerialNumber ?? "").Replace(",", " ");
                string outTime = m.LastOutTime.HasValue ? m.LastOutTime.Value.ToString("HH:mm:ss") : "";
                string outMach = (m.OutDeviceName ?? m.OutSerialNumber ?? "").Replace(",", " ");
                string remarks = (m.Remarks ?? "").Replace(",", ";");
                string desig = (m.Designation ?? "Colliery Worker").Replace(",", " ");
                string authStatus = m.IsHigherAuthority ? "Executive" : "General Personnel";
                string regStatus = m.IsManuallyCorrected ? "Yes (Manual)" : "No (Turnstile)";
                string corrBy = (m.CorrectedBy ?? "").Replace(",", " ");
                string corrReason = (m.CorrectionReason ?? "").Replace(",", ";");

                sb.AppendLine($"{m.AttendanceDate:yyyy-MM-dd},{m.EmpCode},{m.EmployeeName ?? ""},{desig},{authStatus},{m.SubAreaName},{m.ShiftCode},{inTime},{inMach},{outTime},{outMach},{m.TotalWorkHours},{m.EarlyInMinutes},{m.LateByMinutes},{m.EarlyExitMinutes},{Math.Round(m.OvertimeMinutes/60.0, 1)},{m.Status},{regStatus},{corrBy},{corrReason},{remarks}");
            }

            string base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            string fileName = musterFromDate == musterToDate 
                ? $"ECL_AttendanceReport_{musterFromDate:yyyyMMdd}.csv" 
                : $"ECL_AttendanceReport_{musterFromDate:yyyyMMdd}_to_{musterToDate:yyyyMMdd}.csv";

            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.download = '{fileName}';
                link.href = 'data:text/csv;base64,{base64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");

            successMessage = $"Exported attendance report to {fileName}.";
        }
        catch (Exception ex)
        {
            errorMessage = "Export failed: " + ex.Message;
        }
    }

    private async Task LoadLogsAsync()
    {
        if (filterFromDate.HasValue) UserSession.AttendanceFromDate = filterFromDate.Value;
        if (filterToDate.HasValue) UserSession.AttendanceToDate = filterToDate.Value;
        musterFromDate = UserSession.AttendanceFromDate;
        musterToDate = UserSession.AttendanceToDate;

        isLoading = true;
        try
        {
            var filter = new AttendanceFilterDto(
                AreaId: UserSession.CurrentAreaId,
                SubAreaId: subAreaFilter > 0 ? subAreaFilter : UserSession.CurrentSubAreaId,
                Status: statusFilter,
                FromDate: filterFromDate,
                ToDate: filterToDate,
                SearchTerm: searchTerm
            );

            logs = await AttendanceService.GetLogsAsync(filter, UserSession.CurrentAreaId, UserSession.CurrentSubAreaId);
            flaggedCount = await AttendanceService.GetFlaggedCountAsync(UserSession.CurrentAreaId, UserSession.CurrentSubAreaId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load attendance logs: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<AttendanceLogDto> FilteredLogs
    {
        get
        {
            var q = logs.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string s = searchTerm.Trim().ToLower();
                q = q.Where(l => l.EmpCode.ToLower().Contains(s) ||
                                 (l.EmployeeName != null && l.EmployeeName.ToLower().Contains(s)) ||
                                 (l.DeviceName != null && l.DeviceName.ToLower().Contains(s)) ||
                                 l.SerialNumber.ToLower().Contains(s));
            }

            if (subAreaFilter > 0)
            {
                q = q.Where(l => l.SubAreaId == subAreaFilter);
            }

            if (!string.IsNullOrWhiteSpace(statusFilter) && !statusFilter.Equals("All", StringComparison.OrdinalIgnoreCase))
            {
                q = q.Where(l => l.Status == statusFilter);
            }

            return q;
        }
    }

