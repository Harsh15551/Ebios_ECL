    private async Task TransmitSftpAsync()
    {
        isSftpTransmitting = true;
        sftpTransmitResult = null;
        try
        {
            int? areaId = UserSession.IsAreaAdmin ? UserSession.CurrentUser?.AreaId : null;
            int? subAreaId = musterSubAreaId > 0 ? musterSubAreaId : (UserSession.IsUnitAdmin ? UserSession.CurrentUser?.SubAreaId : null);

            sftpTransmitResult = await SftpService.ExportAndUploadDailyAttendanceAsync(
                sftpTargetDate,
                areaId,
                subAreaId,
                triggerType: "MANUAL_PUSH",
                userId: UserSession.CurrentUser?.Id,
                username: UserSession.CurrentUser?.Username ?? "Officer",
                officerName: UserSession.CurrentUser?.FullName ?? "Officer",
                role: UserSession.CurrentUser?.Role.ToString() ?? "Officer");

            if (sftpTransmitResult.Success)
            {
                successMessage = $"Transmitted {sftpTransmitResult.RecordCount} attendance records to SFTP server.";
            }

            await LoadSftpAuditDataAsync();
        }
        catch (Exception ex)
        {
            sftpTransmitResult = new SftpExportResultDto(false, ex.Message);
        }
        finally
        {
            isSftpTransmitting = false;
        }
