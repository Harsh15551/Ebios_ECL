    private IEnumerable<AttendanceLogDto> FilteredLogs
    {
        get
        {
            var q = logs.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                string s = searchTerm.Trim().ToLower();
                q = q.Where(l => l.EmpCode.ToLower().Contains(s) ||
                                 (l.EmployeeName != null && l.EmployeeName.ToLower().Contains(s)) ||
                                 (l.DeviceName != null && l.DeviceName.ToLower().Contains(s)) ||
                                 l.SerialNumber.ToLower().Contains(s));
            }

            if (subAreaFilter > 0)
            {
                q = q.Where(l => l.SubAreaId == subAreaFilter);
            }

            if (!string.IsNullOrWhiteSpace(statusFilter) && !statusFilter.Equals("All", StringComparison.OrdinalIgnoreCase))
            {
                q = q.Where(l => l.Status == statusFilter);
            }

            return q;
        }
    }

