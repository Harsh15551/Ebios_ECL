        regularizeOutTime = m.LastOutTime.HasValue ? TimeOnly.FromDateTime(m.LastOutTime.Value) : null;
        regularizeShiftCode = m.ShiftCode;

        if (!string.IsNullOrEmpty(m.CorrectionReason))
        {
            var presets = new[] {
                "Pithead turnstile power failure / Jam",
                "Biometric reader / Fingerprint sensor fault",
                "Deputed on official duty / ECL HQ movement",
                "Emergency mine rescue / Drainage deployment",
                "Shift handover delay approved by Colliery Manager"
            };
            if (presets.Contains(m.CorrectionReason))
            {
                regularizeSelectedReasonPreset = m.CorrectionReason;
                regularizeCustomReason = string.Empty;
            }
            else
            {
                regularizeSelectedReasonPreset = "Custom";
                regularizeCustomReason = m.CorrectionReason;
            }
        }
        else
        {
            regularizeSelectedReasonPreset = "Pithead turnstile power failure / Jam";
            regularizeCustomReason = string.Empty;
