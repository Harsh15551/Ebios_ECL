    private async Task ProcessBulkRegularizationUploadAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkRegularizeCsvText))
        {
            bulkRegularizeModalError = "Please select a file or paste CSV data.";
            return;
        }

        isBulkRegularizing = true;
        bulkRegularizeModalError = null;
        bulkRegularizeModalSuccess = null;

        try
        {
            var lines = bulkRegularizeCsvText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            var entries = new List<BulkRegularizeEntryDto>();

            for (int i = 0; i < lines.Length; i++)
            {
                string line = lines[i].Trim();
                if (string.IsNullOrWhiteSpace(line)) continue;

                var parts = line.Split(new[] { ',', '\t', ';' });
                if (parts.Length < 2) continue;

                string code = parts[0].Trim();
                if (code.Equals("EmpCode", StringComparison.OrdinalIgnoreCase) || 
                    code.Equals("Worker", StringComparison.OrdinalIgnoreCase) ||
                    code.StartsWith("#"))
                {
                    continue;
                }

                // Check if row is Format B: EmpCode, DateIn, InTime, DateOut, OutTime, Reason[, ShiftCode]
                // Detected when parts has >= 5 columns and parts[3] parses as a full date (contains date separator)
                bool isTwoDateRow = parts.Length >= 5 &&
                                    (parts[3].Contains('-') || parts[3].Contains('/') || parts[3].Contains('.')) &&
                                    DateTime.TryParse(parts[3].Trim(), out _);

                DateTime targetDate;
                DateTime? inTime = null;
                DateTime? outTime = null;
                string reason = "Bulk Administrative Regularization";
                string? shiftCode = null;

                if (isTwoDateRow)
                {
                    // Format B: EmpCode, DateIn, InTime, DateOut, OutTime, Reason
                    if (!DateTime.TryParse(parts[1].Trim(), out var dateIn)) continue;
                    targetDate = dateIn;

                    if (!string.IsNullOrWhiteSpace(parts[2]))
                    {
                        string rawIn = parts[2].Trim();
                        if (TimeSpan.TryParse(rawIn, out var tsIn)) inTime = dateIn.Date.Add(tsIn);
                        else if (DateTime.TryParse(rawIn, out var dtIn)) inTime = dtIn;
                    }

                    if (DateTime.TryParse(parts[3].Trim(), out var dateOut) && parts.Length >= 5 && !string.IsNullOrWhiteSpace(parts[4]))
                    {
                        string rawOut = parts[4].Trim();
                        if (TimeSpan.TryParse(rawOut, out var tsOut)) outTime = dateOut.Date.Add(tsOut);
                        else if (DateTime.TryParse(rawOut, out var dtOut)) outTime = dtOut;
                    }

                    if (parts.Length >= 6 && !string.IsNullOrWhiteSpace(parts[5]))
                    {
                        reason = parts[5].Trim();
                    }

                    if (parts.Length >= 7 && !string.IsNullOrWhiteSpace(parts[6]))
                    {
                        shiftCode = parts[6].Trim();
                    }
                }
                else
                {
                    // Format A: EmpCode, Date, InTime, OutTime, Reason
                    if (!DateTime.TryParse(parts[1].Trim(), out targetDate))
                    {
                        continue;
                    }

                    if (parts.Length >= 3 && !string.IsNullOrWhiteSpace(parts[2]))
                    {
                        string rawIn = parts[2].Trim();
                        if (TimeSpan.TryParse(rawIn, out var tsIn))
                        {
                            inTime = targetDate.Date.Add(tsIn);
                        }
                        else if (DateTime.TryParse(rawIn, out var dtIn))
                        {
                            inTime = dtIn;
                        }
                    }

                    if (parts.Length >= 4 && !string.IsNullOrWhiteSpace(parts[3]))
                    {
                        string rawOut = parts[3].Trim();
                        if (TimeSpan.TryParse(rawOut, out var tsOut))
                        {
                            outTime = targetDate.Date.Add(tsOut);
                            if (inTime.HasValue && outTime < inTime)
                            {
                                outTime = outTime.Value.AddDays(1);
                            }
                        }
                        else if (DateTime.TryParse(rawOut, out var dtOut))
                        {
                            outTime = dtOut;
                        }
                    }

                    if (parts.Length >= 5 && !string.IsNullOrWhiteSpace(parts[4]))
                    {
                        reason = parts[4].Trim();
                    }

                    if (parts.Length >= 6 && !string.IsNullOrWhiteSpace(parts[5]))
                    {
                        shiftCode = parts[5].Trim();
                    }
                }

                entries.Add(new BulkRegularizeEntryDto(code, targetDate, inTime, outTime, reason, shiftCode));
            }

            if (entries.Count == 0)
            {
                bulkRegularizeModalError = "No valid regularization records found. Check the expected format.";
                return;
            }

            var result = await AttendanceProcessingService.BulkRegularizeAsync(
                entries, 
                UserSession.CurrentUser?.Username ?? "Admin",
                UserSession.CurrentAreaId,
                UserSession.CurrentSubAreaId
            );
            
            if (result.Errors.Count == 0)
            {
                successMessage = $"Successfully regularized and locked {result.SuccessCount} attendance record(s).";
                CloseBulkRegularizeModal();
                await LoadMusterRollAsync();
            }
            else
            {
                bulkRegularizeModalSuccess = $"Processed {result.SuccessCount} of {result.TotalCount} record(s).";
                bulkRegularizeModalError = $"{result.Errors.Count} error(s): " + string.Join(" | ", result.Errors.Take(3));
                await LoadMusterRollAsync();
            }
        }
        catch (Exception ex)
        {
            bulkRegularizeModalError = "Bulk processing error: " + ex.Message;
        }
        finally
        {
            isBulkRegularizing = false;
        }
    }

