    private async Task SaveRegularizationAsync()
    {
        if (selectedMusterRecord == null) return;

        string reason = regularizeSelectedReasonPreset == "Custom" ? regularizeCustomReason : regularizeSelectedReasonPreset;
        if (string.IsNullOrWhiteSpace(reason))
        {
            regularizeModalError = "Please specify a regularization reason.";
            return;
        }

        DateTime? inTime = regularizeInTime.HasValue 
            ? selectedMusterRecord.AttendanceDate.Date.Add(regularizeInTime.Value.ToTimeSpan()) 
            : null;

        DateTime? outTime = regularizeOutTime.HasValue 
            ? selectedMusterRecord.AttendanceDate.Date.Add(regularizeOutTime.Value.ToTimeSpan()) 
            : null;

        if (inTime.HasValue && outTime.HasValue && outTime < inTime)
        {
            outTime = outTime.Value.AddDays(1);
        }

        isRegularizing = true;
        regularizeModalError = null;

        try
        {
            var dto = new RegularizeAttendanceDto(
                selectedMusterRecord.Id,
                inTime,
                outTime,
                reason,
                UserSession.CurrentUser?.Username ?? "Admin",
                regularizeShiftCode
            );

            var (success, msg) = await AttendanceProcessingService.RegularizeAttendanceAsync(
                dto, 
                UserSession.CurrentAreaId, 
                UserSession.CurrentSubAreaId
            );
            if (success)
            {
                successMessage = msg;
                CloseRegularizeModal();
                await LoadMusterRollAsync();
            }
            else
            {
                regularizeModalError = msg;
            }
        }
        catch (Exception ex)
        {
            regularizeModalError = "Failed to save regularization: " + ex.Message;
        }
        finally
        {
            isRegularizing = false;
        }
    }

