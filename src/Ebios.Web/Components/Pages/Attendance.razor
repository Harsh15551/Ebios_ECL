    private async Task OpenSftpModal()
    {
        sftpTargetDate = musterToDate;
        sftpTestStatus = null;
        sftpTransmitResult = null;
        sftpHostPreview = Environment.GetEnvironmentVariable("SFTP_HOST") ?? Configuration["SftpServer:Host"] ?? "127.0.0.1";
        string portStr = Environment.GetEnvironmentVariable("SFTP_PORT") ?? Configuration["SftpServer:Port"] ?? "22";
        int.TryParse(portStr, out sftpPortPreview);
        if (sftpPortPreview <= 0) sftpPortPreview = 22;
        sftpUserPreview = Environment.GetEnvironmentVariable("SFTP_USERNAME") ?? Configuration["SftpServer:UserName"] ?? "tester";
        sftpDirPreview = Environment.GetEnvironmentVariable("SFTP_REMOTE_PATH") ?? Configuration["SftpServer:RemotePath"] ?? "/";
        sftpScheduleTimePreview = SftpService.GetDailyScheduleTime();
        editingSftpScheduleTime = sftpScheduleTimePreview;
        sftpScheduleTimeMessage = null;
        isSftpModalOpen = true;

        await LoadSftpAuditDataAsync();
    }

    private async Task SaveSftpScheduleTimeAsync()
    {
        isSavingScheduleTime = true;
        sftpScheduleTimeMessage = null;
        try
        {
            var (success, msg) = await SftpService.SetDailyScheduleTimeAsync(
                editingSftpScheduleTime,
                UserSession.CurrentUser?.Id,
                UserSession.CurrentUser?.Username ?? "admin",
                UserSession.CurrentUser?.FullName ?? "Administrator",
                UserSession.CurrentUser?.Role.ToString() ?? "SuperAdmin");

            sftpScheduleTimeSuccess = success;
            sftpScheduleTimeMessage = msg;
            if (success)
            {
                sftpScheduleTimePreview = SftpService.GetDailyScheduleTime();
                editingSftpScheduleTime = sftpScheduleTimePreview;
                await LoadSftpAuditDataAsync();
            }
        }
        catch (Exception ex)
        {
            sftpScheduleTimeSuccess = false;
            sftpScheduleTimeMessage = ex.Message;
        }
        finally
        {
            isSavingScheduleTime = false;
        }
    }

    private async Task LoadSftpAuditDataAsync()
    {
        try
        {
            lastSftpStatus = await AuditService.GetLastSftpStatusAsync();
            recentSftpLogs = await AuditService.GetRecentSftpLogsAsync(5);
        }
        catch
        {
            // Non-critical UI state
        }
    }

