@page "/attendance"
@rendermode InteractiveServer
@using Ebios.Application.Common
@inject IAttendanceService AttendanceService
@inject IAttendanceProcessingService AttendanceProcessingService
@inject IShiftService ShiftService
@inject IEmployeeService EmployeeService
@inject IAreaService AreaService
@inject ISftpAttendanceService SftpService
@inject IAuditService AuditService
@inject IConfiguration Configuration
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ECL - Daily Attendance Report</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-1">Daily Attendance Report</h2>
            @if (UserSession.IsSuperAdmin)
            {
                <span class="badge bg-danger">ECL HQ Global Scope</span>
            }
            else if (UserSession.IsAreaAdmin)
            {
                <span class="badge bg-primary">@(UserSession.CurrentUser?.AreaName) Area Scope</span>
            }
            else
            {
                <span class="badge bg-info text-dark">@(UserSession.CurrentUser?.SubAreaName) Unit Scope</span>
            }
        </div>
        <p class="text-muted mb-0">
            Real-time biometric turnstile punches, shift calculations, and official daily attendance reporting.
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (activeMainTab == "muster")
        {
            @if (UserSession.CanManageShifts || UserSession.CanManageEmployees || UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
            {
                <button class="btn btn-outline-warning btn-sm" @onclick="OpenBulkRegularizeModal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                        <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
                    </svg>
                    <span>Bulk Regularize</span>
                </button>
            }
            <button class="btn btn-outline-success btn-sm" @onclick="ExportMusterRollToCsv" disabled="@isMusterLoading">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                </svg>
                <span>Export CSV</span>
            </button>
            <button class="btn btn-outline-info btn-sm" @onclick="OpenSftpModal" title="Send standardized daily attendance CSV via SFTP">
                <i class="bi bi-cloud-arrow-up me-1"></i>
                <span>Push to SFTP</span>
            </button>
            <button class="btn btn-outline-primary btn-sm" @onclick="RecalculateMusterRollAsync" disabled="@isRecalculating">
                @if (isRecalculating)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Recalculating...</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                    </svg>
                    <span>Recalculate Range</span>
                }
            </button>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadLogsAsync" disabled="@isLoading">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                </svg>
                <span>Refresh Stream</span>
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Success:</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Error:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

<!-- Main Tab Bar -->
<ul class="nav nav-pills mb-4 border-bottom pb-2">
    <li class="nav-item">
        <button class="nav-link @(activeMainTab == "muster" ? "active" : "")" @onclick="@(() => SwitchTab("muster"))">
            <i class="bi bi-file-earmark-ruled me-1"></i> 📊 Daily Attendance Report
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeMainTab == "punches" ? "active" : "")" @onclick="@(() => SwitchTab("punches"))">
            <i class="bi bi-broadcast me-1"></i> ⚡ Raw Biometric Stream (@(logs.Count))
            @{
                int streamFlagged = logs.Count(l => l.IsFlagged || l.Status == "Flagged");
            }
            @if (streamFlagged > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@streamFlagged Flagged</span>
            }
            else if (flaggedCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@flaggedCount Pending</span>
            }
        </button>
    </li>
</ul>

@if (activeMainTab == "muster")
{
    <!-- Muster Roll KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-primary border-4 shadow-sm">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Workers Active</div>
                    <div class="h4 fw-bold mb-0 text-dark">@musterKpis.TotalPunches</div>
                    <small class="text-muted text-truncate d-block">@(musterFromDate == musterToDate ? musterFromDate.ToString("dd MMM yyyy") : $"{musterFromDate:dd MMM} - {musterToDate:dd MMM}")</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-success border-4 shadow-sm">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Present (Full)</div>
                    <div class="h4 fw-bold mb-0 text-success">@musterKpis.PresentCount</div>
                    <small class="text-muted text-truncate d-block">&ge; 7.5 hrs</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-warning border-4 shadow-sm">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Late Entries</div>
                    <div class="h4 fw-bold mb-0 text-warning">@musterKpis.LateCount</div>
                    <small class="text-muted text-truncate d-block">&gt; 30m Grace</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-info border-4 shadow-sm">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Early Left</div>
                    <div class="h4 fw-bold mb-0 text-info">@musterKpis.EarlyExitCount</div>
                    <small class="text-muted text-truncate d-block">Before Shift End</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-4 shadow-sm" style="border-left-color: #6f42c1 !important;">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Double Shift / OT</div>
                    <div class="h4 fw-bold mb-0" style="color: #6f42c1;">@musterKpis.DoubleShiftCount</div>
                    <small class="text-muted text-truncate d-block">&ge; 14 hrs or OT</small>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100 border-start border-danger border-4 shadow-sm">
                <div class="card-body py-2 px-3">
                    <div class="text-muted small fw-semibold text-uppercase text-truncate">Missed OUT</div>
                    <div class="h4 fw-bold mb-0 text-danger">@musterKpis.SinglePunchCount</div>
                    <small class="text-muted text-truncate d-block">Single punch only</small>
                </div>
            </div>
        </div>
    </div>



    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- Row 1: Dates, Jurisdiction, Shift Category & Shifts, Timing Anomaly -->
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">From Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="musterFromDate" @bind:after="LoadMusterRollAsync" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">To Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="musterToDate" @bind:after="LoadMusterRollAsync" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">Colliery / Sub-Area</label>
                    <select class="form-select form-select-sm" @bind="musterSubAreaId" @bind:after="LoadMusterRollAsync" disabled="@UserSession.IsUnitAdmin">
                        @if (!UserSession.IsUnitAdmin)
                        {
                            <option value="0">All Colliery Units</option>
                        }
                        @foreach (var sub in permittedSubAreas)
                        {
                            <option value="@sub.Id">@sub.SubAreaName</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">Shift Type</label>
                    <select class="form-select form-select-sm" @bind="musterShiftCategory">
                        <option value="All">All Shift Types</option>
                        <option value="Day">☀️ Day Shifts Only</option>
                        <option value="Night">🌙 Night Shifts (Cross-Midnight)</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">Specific Shift</label>
                    <select class="form-select form-select-sm" @bind="musterShiftCode" @bind:after="LoadMusterRollAsync">
                        <option value="All">All Shifts</option>
                        @foreach (var s in masterShifts)
                        {
                            <option value="@s.ShiftCode">@s.ShiftCode (@s.StartTime.ToString(@"hh\:mm")-@s.EndTime.ToString(@"hh\:mm"))</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold">Timing Anomaly</label>
                    <select class="form-select form-select-sm" @bind="musterTimingAnomaly">
                        <option value="All">All Timings</option>
                        <option value="EarlyIn">🟢 Early IN (&gt;30m early)</option>
                        <option value="LateIn">⚠️ Late IN (Grace exceeded)</option>
                        <option value="EarlyOut">⚠️ Early OUT (Before shift end)</option>
                        <option value="LateOut">🟣 Late OUT / Overtime (OT &gt; 0)</option>
                        <option value="OnTime">✅ Strictly On-Time</option>
                    </select>
                </div>
            </div>

            <!-- Row 2: Status, Flag Status, Search -->
            <div class="row g-2 align-items-end mt-2 pt-2 border-top">
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold">Muster Status</label>
                    <select class="form-select form-select-sm" @bind="musterStatus" @bind:after="LoadMusterRollAsync">
                        <option value="All">All Statuses</option>
                        <option value="Present">Present</option>
                        <option value="Late">Late Entry</option>
                        <option value="Double Shift">Double Shift / OT</option>
                        <option value="Half Day">Half Day</option>
                        <option value="Single Punch">Missed OUT</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold">Badge Status</label>
                    <select class="form-select form-select-sm" @bind="musterFlagFilter">
                        <option value="All">All Workers</option>
                        <option value="Flagged">🚩 Flagged Only (Unregistered)</option>
                        <option value="NonFlagged">✅ Registered Only</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold">Search Worker / Machine</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Search ID, Name, Machine, Shift..." @bind="musterSearchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Report Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">Official Attendance Report: @musterFromDate.ToString("dd MMM yyyy") to @musterToDate.ToString("dd MMM yyyy")</h6>
            <span class="badge bg-primary">@(FilteredMusterRoll.Count) Records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap" style="width: 95px;">Date</th>
                        <th class="text-nowrap" style="width: 100px;">Worker ID</th>
                        <th class="text-nowrap">Worker Name</th>
                        <th class="text-nowrap">Designation</th>
                        <th class="text-nowrap">Colliery / Unit</th>
                        <th class="text-nowrap" style="width: 90px;">Shift</th>
                        <th class="text-nowrap" style="width: 130px;">First IN</th>
                        <th class="text-nowrap" style="width: 130px;">Last OUT</th>
                        <th class="text-nowrap" style="width: 80px;">Duration</th>
                        <th class="text-nowrap" style="width: 110px;">Late / Early</th>
                        <th class="text-nowrap" style="width: 80px;">Overtime</th>
                        <th class="text-nowrap" style="width: 120px;">Status</th>
                        <th class="text-end text-nowrap" style="width: 90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isMusterLoading)
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span> Calculating Daily Attendance Report...
                            </td>
                        </tr>
                    }
                    else if (!FilteredMusterRoll.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <div>No attendance records found between @musterFromDate.ToString("dd-MM-yyyy") and @musterToDate.ToString("dd-MM-yyyy").</div>
                                <small>Click <strong>"Recalculate Range"</strong> above to process existing punches into the attendance report.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in FilteredMusterRoll)
                        {
                            <tr class="@(m.IsFlagged ? "table-warning bg-opacity-10" : "")">
                                <td class="fw-bold text-nowrap">@m.AttendanceDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-bold text-dark font-monospace text-nowrap">@m.EmpCode</td>
                                <td>
                                    <span class="fw-semibold text-truncate d-inline-block" style="max-width: 160px;" title="@m.EmployeeName">@(m.EmployeeName ?? "—")</span>
                                    @if (m.IsHigherAuthority)
                                    {
                                        <span class="badge ms-1" style="background-color: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; font-size: 0.70rem;" title="Executive: single-punch attendance permitted">👔 Executive</span>
                                    }
                                    @if (m.IsManuallyCorrected)
                                    {
                                        <button type="button" class="btn btn-link p-0 text-decoration-none badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1"
                                                @onclick="@(() => OpenRecordAuditHistoryModal(m.EmpCode, m.AttendanceDate))"
                                                title="Click to view full modification history (Logged by @m.CorrectedBy: @m.CorrectionReason)">
                                            ✏️ Regularized <i class="bi bi-clock-history ms-1"></i>
                                        </button>
                                    }
                                    @if (m.IsFlagged)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" title="Unregistered Badge">🚩 Flagged: Unregistered</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(m.Designation ?? "Colliery Worker")</span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@m.SubAreaName">@m.SubAreaName</span>
                                </td>
                                <td class="text-nowrap">
                                    @{
                                        var sm = masterShifts.FirstOrDefault(s => s.ShiftCode == m.ShiftCode);
                                        bool isNightShift = sm != null && (sm.IsNightShift || sm.EndTime < sm.StartTime);
                                    }
                                    <span class="badge @(isNightShift ? "text-white" : "bg-dark") font-monospace" style="@(isNightShift ? "background-color: #3730a3;" : "")" title="@(isNightShift ? "Night Shift (Cross-Midnight)" : "Day Shift")">
                                        @(isNightShift ? "🌙 " : "☀️ ")@m.ShiftCode
                                    </span>
                                    @if (m.RosterStatus == "Auto-Matched")
                                    {
                                        <span class="badge bg-light text-muted border ms-1" title="Auto-matched by Shift Window">Auto</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (m.FirstInTime.HasValue)
                                    {
                                        <div>
                                            <span class="fw-bold text-success font-monospace">@m.FirstInTime.Value.ToString("HH:mm:ss")</span>
                                            <small class="text-muted d-block text-truncate" style="max-width: 130px;" title="Machine: @m.InSerialNumber">
                                                @(m.InDeviceName ?? m.InSerialNumber ?? "Terminal")
                                            </small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (m.LastOutTime.HasValue)
                                    {
                                        <div>
                                            <span class="fw-bold text-danger font-monospace">@m.LastOutTime.Value.ToString("HH:mm:ss")</span>
                                            @if (m.FirstInTime.HasValue && m.LastOutTime.Value.Date > m.FirstInTime.Value.Date)
                                            {
                                                <span class="badge bg-purple-subtle text-purple border ms-1" style="font-size: 0.68rem;" title="Exit punch recorded on next calendar day (@m.LastOutTime.Value.ToString("dd-MM-yyyy"))">+1 Day</span>
                                            }
                                            <small class="text-muted d-block text-truncate" style="max-width: 130px;" title="Machine: @m.OutSerialNumber">
                                                @(m.OutDeviceName ?? m.OutSerialNumber ?? "Terminal")
                                            </small>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (m.IsHigherAuthority)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">⚠️ No Exit</span>
                                        }
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (m.TotalWorkMinutes > 0)
                                    {
                                        <span class="fw-bold font-monospace">@m.TotalWorkHours hrs</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (m.IsHigherAuthority)
                                    {
                                        <span class="badge bg-light text-muted border">Exempt</span>
                                    }
                                    else
                                    {
                                        @if (m.EarlyInMinutes > 0)
                                        {
                                            <span class="badge bg-info text-dark" title="Punched in before reporting window">Early IN @(m.EarlyInMinutes)m</span>
                                        }
                                        @if (m.LateByMinutes > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Late @(m.LateByMinutes)m</span>
                                        }
                                        @if (m.EarlyExitMinutes > 0)
                                        {
                                            <span class="badge bg-danger text-white ms-1">Early Exit @(m.EarlyExitMinutes)m</span>
                                        }
                                        @if (m.LateByMinutes == 0 && m.EarlyInMinutes == 0 && m.EarlyExitMinutes == 0 && m.FirstInTime.HasValue && m.LastOutTime.HasValue)
                                        {
                                            <span class="badge bg-light text-success border">On-Time</span>
                                        }
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (!m.IsHigherAuthority && m.OvertimeMinutes > 0)
                                    {
                                        <span class="badge bg-primary font-monospace">+@Math.Round(m.OvertimeMinutes / 60.0, 1) hrs</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (m.IsHigherAuthority)
                                    {
                                        <span class="badge bg-success">● Present</span>
                                    }
                                    else if (m.Status == "Double Shift")
                                    {
                                        <span class="badge bg-purple text-white" style="background-color: #6f42c1;">⚡ Double Shift</span>
                                    }
                                    else if (m.Status.StartsWith("Present"))
                                    {
                                        <span class="badge bg-success">● @m.Status</span>
                                    }
                                    else if (m.Status == "Half Day")
                                    {
                                        <span class="badge bg-info text-dark">🌗 Half Day</span>
                                    }
                                    else if (m.Status.StartsWith("Single Punch"))
                                    {
                                        <span class="badge bg-danger">⚠️ Missed OUT</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@m.Status</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (m.IsFlagged)
                                        {
                                            @if (UserSession.CanManageEmployees)
                                            {
                                                <button class="btn btn-warning btn-sm py-0 px-2 fw-semibold" @onclick="@(() => OpenQuickOnboardModalForMuster(m))" title="Onboard Worker">
                                                    ➕ Onboard
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-dark border">Unregistered</span>
                                            }
                                        }

                                        @if (UserSession.CanManageShifts || UserSession.CanManageEmployees || UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
                                        {
                                            @if (m.IsManuallyCorrected)
                                            {
                                                <button class="btn btn-outline-info btn-sm py-0 px-2 fw-semibold" @onclick="@(() => OpenRegularizeModal(m))" title="Edit Manual Correction (Logged by @m.CorrectedBy)">
                                                    ✏️ Edit
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1 ms-1" @onclick="@(() => OpenRecordAuditHistoryModal(m.EmpCode, m.AttendanceDate))" title="View Audit Trail for this record">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="@(() => OpenRegularizeModal(m))" title="Manual Punch Regularization">
                                                    ✏️ Regularize
                                                </button>
                                            }
                                        }
                                        else if (!m.IsFlagged)
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- Raw Biometric Stream Tab (Existing UI) -->
    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100 border-start border-primary border-4 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Total Punches</div>
                    <div class="h3 fw-bold mb-0 text-dark">@logs.Count</div>
                    <small class="text-muted">In current stream view</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100 border-start border-success border-4 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Verified Punches</div>
                    <div class="h3 fw-bold mb-0 text-success">@logs.Count(l => l.Status == "Verified")</div>
                    <small class="text-muted">Recognized scans (@logs.Where(l => l.Status == "Verified").Select(l => l.EmpCode).Distinct().Count() workers)</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100 border-start border-warning border-4 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Flagged Punches</div>
                    <div class="h3 fw-bold mb-0 text-warning">@logs.Count(l => l.IsFlagged || l.Status == "Flagged")</div>
                    <small class="text-muted">Unregistered in view (@flaggedCount all-time)</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100 border-start border-secondary border-4 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Dismissed Punches</div>
                    <div class="h3 fw-bold mb-0 text-secondary">@logs.Count(l => l.Status == "Dismissed")</div>
                    <small class="text-muted">Visitors or test scans</small>
                </div>
            </div>
        </div>
    </div>



    <!-- Filters Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold mb-1">Search</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Code, Name, Machine..." @bind="searchTerm" @bind:event="oninput" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">From Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="filterFromDate" @bind:after="LoadLogsAsync" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">To Date</label>
                    <input type="date" class="form-control form-control-sm" @bind="filterToDate" @bind:after="LoadLogsAsync" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">Colliery Unit</label>
                    <select class="form-select form-select-sm" @bind="subAreaFilter" @bind:after="LoadLogsAsync" disabled="@UserSession.IsUnitAdmin">
                        @if (!UserSession.IsUnitAdmin)
                        {
                            <option value="0">All Colliery Units</option>
                        }
                        @foreach (var sub in permittedSubAreas)
                        {
                            <option value="@sub.Id">@sub.SubAreaName</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1">Status</label>
                    <select class="form-select form-select-sm" @bind="statusFilter" @bind:after="LoadLogsAsync">
                        <option value="All">All Statuses</option>
                        <option value="Verified">Verified</option>
                        <option value="Flagged">Flagged</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                </div>

                <div class="col-6 col-md-1">
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LoadLogsAsync" disabled="@isLoading">
                        Apply
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Raw Logs Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 120px;">Worker ID</th>
                        <th>Worker Name</th>
                        <th>Colliery / Unit</th>
                        <th>Punch Time (LogDate)</th>
                        <th>Device / Machine</th>
                        <th>Direction</th>
                        <th>Type</th>
                        <th style="width: 120px;">Status</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span> Loading biometric logs...
                            </td>
                        </tr>
                    }
                    else if (!FilteredLogs.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
                                <div>No biometric punches found in this view.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var l in FilteredLogs)
                        {
                            <tr class="@(l.IsFlagged ? "table-warning bg-opacity-25" : "")">
                                <td class="font-monospace fw-bold">@l.EmpCode</td>
                                <td>
                                    <span class="fw-semibold">@(l.EmployeeName ?? "—")</span>
                                </td>
                                <td>@l.SubAreaName</td>
                                <td>
                                    <span class="fw-bold">@l.LogDate.ToString("dd-MM-yyyy HH:mm:ss")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@l.DeviceName</div>
                                    <small class="text-muted font-monospace">@l.SerialNumber</small>
                                </td>
                                <td>
                                    @if (l.Direction.Equals("IN", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">⬇ IN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">⬆ OUT</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(l.VerificationType ?? "Biometric")</span>
                                </td>
                                <td>
                                    @if (l.Status == "Verified")
                                    {
                                        <span class="badge bg-success">● Verified</span>
                                    }
                                    else if (l.Status == "Flagged")
                                    {
                                        <span class="badge bg-warning text-dark">⚠️ Flagged</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Dismissed</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (l.IsFlagged)
                                    {
                                        @if (UserSession.CanManageEmployees)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-primary" title="Onboard Worker" @onclick="@(() => OpenQuickOnboardModal(l))">
                                                    ➕ Onboard
                                                </button>
                                                <button class="btn btn-outline-secondary" title="Dismiss" @onclick="@(() => DismissPunchAsync(l.EmpCode))">
                                                    ✕
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-dark border">Flagged Punch</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Quick Onboard Modal -->
@if (showOnboardModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">➕ Onboard Worker (@onboardEmpCode)</h5>
                    <button type="button" class="btn-close" @onclick="CloseOnboardModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        This badge swiped on the turnstile but is not registered in the ECL directory. Fill the details below to onboard the worker.
                    </p>

                    @if (!string.IsNullOrEmpty(onboardError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@onboardError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Worker ID / Badge Code</label>
                        <input type="text" class="form-control font-monospace" value="@onboardEmpCode" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="e.g. Ramesh Chandra Majhi" @bind="onboardFullName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Designation</label>
                        <input type="text" class="form-control" placeholder="e.g. Mining Sirdar / Colliery Worker" @bind="onboardDesignation" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Colliery Unit <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="onboardSubAreaId" disabled="@UserSession.IsUnitAdmin">
                            <option value="0">-- Select Colliery --</option>
                            @foreach (var sub in permittedSubAreas)
                            {
                                <option value="@sub.Id">@sub.SubAreaName</option>
                            }
                        </select>
                        @if (UserSession.IsUnitAdmin)
                        {
                            <small class="text-muted d-block mt-1">Locked to your assigned colliery unit: @(UserSession.CurrentUser?.SubAreaName).</small>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseOnboardModal" disabled="@isOnboarding">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveOnboardedWorkerAsync" disabled="@isOnboarding">
                        @if (isOnboarding)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Onboarding & Linking...</span>
                        }
                        else
                        {
                            <span>Save & Link Punches</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Manual Punch Regularization (Requirement 16) -->
@if (isRegularizeModalOpen && selectedMusterRecord != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2">
                    <h6 class="modal-title fw-bold mb-0">
                        ✏️ Regularize Punch
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRegularizeModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(regularizeModalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@regularizeModalError</div>
                    }

                    <!-- Worker & Day Info Banner -->
                    <div class="bg-light p-2 rounded mb-3 border small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-bold text-dark">@(selectedMusterRecord.EmployeeName ?? "Worker") (<span class="font-monospace">@selectedMusterRecord.EmpCode</span>)</span>
                            <span class="badge bg-secondary font-monospace">@selectedMusterRecord.ShiftCode</span>
                        </div>
                        <div class="text-muted d-flex justify-content-between">
                            <span>Colliery: <strong>@selectedMusterRecord.SubAreaName</strong></span>
                            <span>Date: <strong>@selectedMusterRecord.AttendanceDate.ToString("dd MMM yyyy")</strong></span>
                        </div>
                    </div>

                    <!-- Current Machine State -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Machine Punches</label>
                        <div class="row g-2 small">
                            <div class="col-6">
                                <div class="border rounded p-2 bg-body-tertiary">
                                    <div class="text-muted" style="font-size: 0.75rem;">MACHINE IN PUNCH</div>
                                    <div class="fw-bold font-monospace text-success">
                                        @(selectedMusterRecord.FirstInTime.HasValue ? selectedMusterRecord.FirstInTime.Value.ToString("HH:mm:ss") : "— None (Missed)")
                                    </div>
                                    <small class="text-muted text-truncate d-block" title="@selectedMusterRecord.InDeviceName">
                                        @(selectedMusterRecord.InDeviceName ?? selectedMusterRecord.InSerialNumber ?? "No Scan")
                                    </small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-2 bg-body-tertiary">
                                    <div class="text-muted" style="font-size: 0.75rem;">MACHINE OUT PUNCH</div>
                                    <div class="fw-bold font-monospace text-danger">
                                        @(selectedMusterRecord.LastOutTime.HasValue ? selectedMusterRecord.LastOutTime.Value.ToString("HH:mm:ss") : "— None (Missed)")
                                    </div>
                                    <small class="text-muted text-truncate d-block" title="@selectedMusterRecord.OutDeviceName">
                                        @(selectedMusterRecord.OutDeviceName ?? selectedMusterRecord.OutSerialNumber ?? "No Scan")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Regularized Punch Inputs -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Entry / IN Time</label>
                            <input type="time" step="1" class="form-control form-control-sm font-monospace" @bind="regularizeInTime" />
                            <small class="text-muted" style="font-size: 0.75rem;">Leave blank to keep existing machine IN</small>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Exit / OUT Time</label>
                            <input type="time" step="1" class="form-control form-control-sm font-monospace" @bind="regularizeOutTime" />
                            <small class="text-muted" style="font-size: 0.75rem;">Leave blank to keep existing machine OUT</small>
                        </div>
                    </div>

                    <!-- Shift Override Selection -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold mb-0">Assigned Shift</label>
                            @if (selectedMusterRecord.RosterStatus == "Auto-Matched")
                            {
                                <span class="badge bg-light text-muted border" style="font-size: 0.70rem;">Auto-Matched</span>
                            }
                            else if (selectedMusterRecord.RosterStatus == "Manual-Overridden")
                            {
                                <span class="badge bg-info-subtle text-info border" style="font-size: 0.70rem;">Manual Overridden</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.70rem;">Rostered Shift</span>
                            }
                        </div>
                        <select class="form-select form-select-sm" @bind="regularizeShiftCode">
                            @foreach (var s in masterShifts)
                            {
                                <option value="@s.ShiftCode">@s.ShiftCode — @s.ShiftName (@s.StartTime.ToString(@"hh\:mm") to @s.EndTime.ToString(@"hh\:mm"))</option>
                            }
                        </select>
                    </div>

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Regularization Reason <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm mb-2" @bind="regularizeSelectedReasonPreset">
                            <option value="Pithead turnstile power failure / Jam">Pithead turnstile power failure / Jam</option>
                            <option value="Biometric reader / Fingerprint sensor fault">Biometric reader / Fingerprint sensor fault</option>
                            <option value="Deputed on official duty / ECL HQ movement">Deputed on official duty / ECL HQ movement</option>
                            <option value="Emergency mine rescue / Drainage deployment">Emergency mine rescue / Drainage deployment</option>
                            <option value="Shift handover delay approved by Colliery Manager">Shift handover delay approved by Colliery Manager</option>
                            <option value="Custom">Other Reason (Specify below)...</option>
                        </select>
                        @if (regularizeSelectedReasonPreset == "Custom")
                        {
                            <input type="text" class="form-control form-control-sm" placeholder="Enter specific reason..." @bind="regularizeCustomReason" />
                        }
                    </div>

                    @if (selectedMusterRecord.IsManuallyCorrected)
                    {
                        <div class="p-2 bg-info-subtle border border-info rounded small mb-2">
                            <div>Reason: <em>@(selectedMusterRecord.CorrectionReason ?? "—")</em></div>
                            <div class="text-muted">By: <strong>@(selectedMusterRecord.CorrectedBy ?? "Admin")</strong> at @(selectedMusterRecord.CorrectedAt?.ToString("dd-MM-yyyy HH:mm") ?? "—")</div>
                        </div>
                    }
                </div>
                <div class="modal-footer d-flex justify-content-between py-2">
                    <div>
                        @if (selectedMusterRecord.IsManuallyCorrected)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RevertRegularizationAsync" disabled="@isRegularizing">
                                ↺ Reset to Machine Punches
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseRegularizeModal" disabled="@isRegularizing">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm fw-semibold" @onclick="SaveRegularizationAsync" disabled="@isRegularizing">
                            @if (isRegularizing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Bulk Attendance Regularization Upload -->
@if (isBulkRegularizeModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-file-earmark-diff me-2 text-warning"></i>
                        Bulk Attendance Regularization (Excel / CSV)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseBulkRegularizeModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(bulkRegularizeModalError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@bulkRegularizeModalError</div>
                    }
                    @if (!string.IsNullOrEmpty(bulkRegularizeModalSuccess))
                    {
                        <div class="alert alert-success py-2 small mb-3">@bulkRegularizeModalSuccess</div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold text-secondary">Step 1: Choose File OR Paste Data</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadSampleRegularizationCsvAsync" title="Download sample_bulk_regularization.csv">
                                📥 Download Sample Template
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FillSampleRegularizationData" title="Auto-fill sample data">
                                📋 Fill Sample Data
                            </button>
                        </div>
                    </div>

                    <!-- File Picker -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Upload CSV / Excel File</label>
                        <InputFile OnChange="HandleBulkRegularizeFileSelectedAsync" class="form-control form-control-sm" accept=".csv,.txt" />
                        <small class="text-muted">Select <code>sample_bulk_regularization.csv</code> from your workspace or any CSV export.</small>
                    </div>

                    <div class="alert alert-info py-2 small mb-3">
                        <strong>Supported Formats:</strong><br />
                        &bull; <strong>Standard Shift:</strong> <code>EmpCode, Date, InTime, OutTime, Reason</code> (e.g. <code>ECL-7001, 2026-11-04, 08:30, 16:30, Power failure</code>)<br />
                        &bull; <strong>Cross-Midnight Night Shift:</strong> <code>EmpCode, DateIn, InTime, DateOut, OutTime, Reason</code> (e.g. <code>ECL-7001, 2026-11-06, 22:00, 2026-11-07, 06:00, Night shift turnstile offline</code>)<br />
                        <span class="text-muted">Tip: Leave InTime or OutTime empty to retain existing turnstile punches (e.g. <code>ECL-7001, 2026-11-04, , 17:00, Missed OUT punch</code> preserves existing 8 AM punch).</span>
                    </div>

                    <!-- Direct Textarea -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CSV / Excel Clipboard Data</label>
                        <textarea class="form-control font-monospace small" rows="7" placeholder="EmpCode,Date,InTime,OutTime,Reason&#10;ECL-7001,2026-11-04,08:30:00,16:30:00,Pithead turnstile power failure&#10;ECL-7002,2026-11-04,,17:00:00,Missed OUT punch due to rush&#10;ECL-7003,2026-11-04,08:45:00,,Missed IN punch due to sensor fault" @bind="bulkRegularizeCsvText"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseBulkRegularizeModal" disabled="@isBulkRegularizing">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm fw-semibold" @onclick="ProcessBulkRegularizationUploadAsync" disabled="@isBulkRegularizing">
                        @if (isBulkRegularizing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Import & Save</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- SFTP Sync Modal -->
@if (isSftpModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-cloud-arrow-up me-2 text-info"></i> SFTP Attendance Dispatch &amp; Transmission Log
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseSftpModal" disabled="@isSftpTransmitting"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Last Transmission Status Card -->
                    @if (lastSftpStatus != null && lastSftpStatus.HasRun)
                    {
                        @if (lastSftpStatus.Status == "DELIVERED_VERIFIED" || lastSftpStatus.Status == "SUCCESS")
                        {
                            <div class="alert alert-success d-flex align-items-center py-2 mb-3">
                                <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                                <div>
                                    <div class="fw-bold small">Last SFTP Sync: 🟢 DELIVERED &amp; VERIFIED</div>
                                    <div class="small text-muted">
                                        Transmitted @lastSftpStatus.Timestamp?.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss") &bull;
                                        <strong>@lastSftpStatus.RecordCount</strong> records (@((lastSftpStatus.FileSizeBytes ?? 0) / 1024.0):F1 KB) &bull;
                                        <code>@lastSftpStatus.FileName</code>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger d-flex align-items-center py-2 mb-3">
                                <i class="bi bi-exclamation-triangle-fill fs-4 me-2 text-danger"></i>
                                <div>
                                    <div class="fw-bold small">Last SFTP Sync: 🔴 FAILED TO DELIVER</div>
                                    <div class="small">@lastSftpStatus.ErrorMessage</div>
                                    <div class="small text-muted">Attempted at @lastSftpStatus.Timestamp?.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</div>
                                </div>
                            </div>
                        }
                    }

                    <p class="text-muted small mb-3">
                        Transmit standardized CSV attendance report directly to the remote SFTP server in the requested format (<code>Employee Id, Attendance date, Capture_date in, Employee time in...</code>).
                    </p>

                    <div class="bg-light p-3 rounded border mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <span class="small fw-semibold text-muted">SFTP Host:</span>
                                <span class="badge bg-secondary font-monospace ms-1">@sftpHostPreview:@sftpPortPreview</span>
                            </div>
                            <div class="col-md-6">
                                <span class="small text-muted">User / Directory:</span>
                                <span class="small font-monospace text-dark ms-1">@sftpUserPreview &rarr; @sftpDirPreview</span>
                            </div>
                            <div class="col-md-12">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div>
                                        <span class="small text-muted">Scheduled Trigger:</span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">
                                            <i class="bi bi-clock me-1"></i> Daily at @sftpScheduleTimePreview (Auto 3-Time Retry on failure)
                                        </span>
                                    </div>
                                    @if (UserSession.IsSuperAdmin || UserSession.IsAreaAdmin)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="small fw-semibold text-dark">Schedule Time:</span>
                                            <input type="text" class="form-control form-control-sm font-monospace text-center" style="width: 85px;" placeholder="23:45" @bind="editingSftpScheduleTime" disabled="@isSavingScheduleTime" />
                                            <button type="button" class="btn btn-sm btn-primary py-1 px-2" @onclick="SaveSftpScheduleTimeAsync" disabled="@isSavingScheduleTime" title="Update daily automated transmission time">
                                                @if (isSavingScheduleTime)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <span><i class="bi bi-check2 me-1"></i>Set Time</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(sftpScheduleTimeMessage))
                                {
                                    <div class="alert @(sftpScheduleTimeSuccess ? "alert-success" : "alert-danger") py-1 px-2 small mt-2 mb-0">
                                        @(sftpScheduleTimeSuccess ? "✅ " : "⚠️ ") @sftpScheduleTimeMessage
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Attendance Date to Transmit</label>
                            <input type="date" class="form-control" @bind="sftpTargetDate" disabled="@isSftpTransmitting" />
                            <div class="form-text text-muted">
                                Exports records matching this date formatted as <code>dd.MM.yyyy</code> with time in/out.
                            </div>
                        </div>
                        <div class="col-md-5 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 py-2" @onclick="TestSftpConnectionAsync" disabled="@isSftpTesting">
                                @if (isSftpTesting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Testing Connection...</span>
                                }
                                else
                                {
                                    <i class="bi bi-plug me-1"></i>
                                    <span>Test SFTP Connection</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(sftpTestStatus))
                    {
                        <div class="alert @(sftpTestStatusSuccess ? "alert-success" : "alert-danger") py-2 small mb-3">
                            @(sftpTestStatusSuccess ? "✅ " : "❌ ") @sftpTestStatus
                        </div>
                    }

                    @if (sftpTransmitResult != null)
                    {
                        <div class="alert @(sftpTransmitResult.Success ? "alert-success" : "alert-danger") py-2 small mb-3">
                            @if (sftpTransmitResult.Success)
                            {
                                <div class="fw-bold mb-1">✅ Upload Successful &amp; Delivery Verified</div>
                                <div><strong>File:</strong> <code>@sftpTransmitResult.RemoteFilePath</code></div>
                                <div><strong>Records Sent:</strong> @sftpTransmitResult.RecordCount</div>
                                <div class="text-muted small mt-1">Uploaded at @sftpTransmitResult.TransmittedAt?.ToLocalTime().ToString("HH:mm:ss")</div>
                            }
                            else
                            {
                                <div class="fw-bold mb-1">❌ Upload Failed</div>
                                <div>@sftpTransmitResult.Message</div>
                            }
                        </div>
                    }

                    <!-- Recent Transmissions Audit Trail Table -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark text-uppercase tracking-wide">
                                <i class="bi bi-clock-history me-1 text-info"></i> Recent SFTP Transmissions Audit
                            </span>
                            <a href="audit-logs?category=SftpDispatch" class="small text-decoration-none" target="_blank">
                                View Full Audit Log &rarr;
                            </a>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 180px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.8rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Remote File</th>
                                        <th class="text-center">Records</th>
                                        <th>Triggered By</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (recentSftpLogs == null || recentSftpLogs.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-2">No past SFTP transmissions logged yet.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var log in recentSftpLogs)
                                        {
                                            <tr>
                                                <td class="font-monospace text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd-MM-yy HH:mm")</td>
                                                <td class="font-monospace text-truncate" style="max-width: 170px;" title="@log.EntityReference">@log.EntityReference</td>
                                                <td class="text-center fw-bold">
                                                    @(log.Details.Contains("Uploaded") ? System.Text.RegularExpressions.Regex.Match(log.Details, @"\d+").Value : "—")
                                                </td>
                                                <td>@log.OfficerName</td>
                                                <td class="text-center">
                                                    @if (log.Status == "SUCCESS" || log.Action == "SFTP_DELIVERED_VERIFIED")
                                                    {
                                                        <span class="badge bg-success">Verified</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger" title="@log.Details">Failed</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseSftpModal" disabled="@isSftpTransmitting">Close</button>
                    <button type="button" class="btn btn-primary btn-sm fw-semibold" @onclick="TransmitSftpAsync" disabled="@isSftpTransmitting">
                        @if (isSftpTransmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Transmitting &amp; Verifying...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-arrow-up me-1"></i>
                            <span>Transmit Now</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================================================== -->
<!-- MODAL: Single Record Audit History (Before vs After)     -->
<!-- ======================================================== -->
@if (isRecordAuditModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-clock-history text-warning me-2"></i>Audit History: @selectedAuditEmpCode &bull; @selectedAuditDate.ToString("dd-MM-yyyy")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRecordAuditHistoryModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (isRecordAuditLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                            <span class="text-muted small">Loading chronological audit trail...</span>
                        </div>
                    }
                    else if (recordAuditLogs == null || recordAuditLogs.Count == 0)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-info-circle fs-3 d-block mb-2 text-secondary"></i>
                            No historical modification events recorded for this record yet.
                        </div>
                    }
                    else
                    {
                        <div class="timeline">
                            @foreach (var log in recordAuditLogs)
                            {
                                <div class="card mb-3 border-start border-4 @(log.Action == "REGULARIZATION_OVERWRITTEN" ? "border-warning" : "border-info") shadow-sm">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <span class="badge @(log.Action == "REGULARIZATION_OVERWRITTEN" ? "bg-warning text-dark" : "bg-info") me-1">
                                                @(log.Action == "REGULARIZATION_OVERWRITTEN" ? "⚠️ Overwritten" : "✏️ Applied")
                                            </span>
                                            <strong class="small text-dark">@log.OfficerName</strong>
                                            <span class="text-muted small">(@log.Role)</span>
                                        </div>
                                        <span class="small font-monospace text-muted">
                                            @log.Timestamp.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")
                                        </span>
                                    </div>
                                    <div class="card-body p-3">
                                        <p class="small mb-2 text-dark">@log.Details</p>

                                        @if (!string.IsNullOrEmpty(log.PreviousStateJson) || !string.IsNullOrEmpty(log.NewStateJson))
                                        {
                                            var prevAttrs = AuditSnapshotFormatter.FormatAttributes(log.PreviousStateJson);
                                            var newAttrs = AuditSnapshotFormatter.FormatAttributes(log.NewStateJson);

                                            <div class="row g-2 mt-2">
                                                @if (prevAttrs.Any())
                                                {
                                                    <div class="col-md-6">
                                                        <div class="card border small">
                                                            <div class="card-header bg-light py-1 fw-semibold text-danger small">
                                                                <i class="bi bi-dash-circle me-1"></i> Original Values
                                                            </div>
                                                            <div class="card-body p-0">
                                                                <table class="table table-sm table-striped table-bordered mb-0 small">
                                                                    <tbody>
                                                                        @foreach (var attr in prevAttrs)
                                                                        {
                                                                            <tr>
                                                                                <td class="fw-semibold text-secondary" style="width: 45%;">@attr.Label</td>
                                                                                <td class="text-dark">@attr.Value</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                @if (newAttrs.Any())
                                                {
                                                    <div class="col-md-@(prevAttrs.Any() ? "6" : "12")">
                                                        <div class="card border small">
                                                            <div class="card-header bg-light py-1 fw-semibold text-success small">
                                                                <i class="bi bi-plus-circle me-1"></i> Modified Values
                                                            </div>
                                                            <div class="card-body p-0">
                                                                <table class="table table-sm table-striped table-bordered mb-0 small">
                                                                    <tbody>
                                                                        @foreach (var attr in newAttrs)
                                                                        {
                                                                            <tr>
                                                                                <td class="fw-semibold text-secondary" style="width: 45%;">@attr.Label</td>
                                                                                <td class="text-dark">@attr.Value</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseRecordAuditHistoryModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
