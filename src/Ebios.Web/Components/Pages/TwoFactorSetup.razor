@page "/security/2fa"
@rendermode InteractiveServer
@inject IUserService UserService
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Two-Factor Authentication Setup - ECL eBios</PageTitle>

<div class="container-fluid px-0 py-2" style="max-width: 800px;">
    <!-- Breadcrumb & Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">
                <i class="bi bi-shield-lock-fill text-primary me-2"></i> Two-Factor Authentication (2FA)
            </h2>
            <p class="text-muted small mb-0">Secure your ECL eBios account using an authenticator app (TOTP) on your mobile device.</p>
        </div>
        <a href="" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isStatusError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>@(isStatusError ? "Error: " : "Success: ")</strong> @statusMessage
            <button type="button" class="btn-close" @onclick="@(() => statusMessage = null)"></button>
        </div>
    }

    <!-- 2FA Status Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center @(is2FaActive ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")" style="width: 52px; height: 52px;">
                        <i class="bi @(is2FaActive ? "bi-shield-check" : "bi-shield-exclamation") fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">
                            Status: @(is2FaActive ? "Active & Protected" : "Not Configured")
                        </h5>
                        <p class="text-muted small mb-0">
                            @(is2FaActive 
                                ? "Your account is secured with Two-Factor Authentication. A 6-digit code is required on every login." 
                                : "Add an extra layer of defense against unauthorized access to ECL colliery attendance data.")
                        </p>
                    </div>
                </div>

                <div>
                    @if (is2FaActive)
                    {
                        <button class="btn btn-outline-danger btn-sm" @onclick="OpenDisablePrompt">
                            <i class="bi bi-x-circle me-1"></i> Disable 2FA
                        </button>
                    }
                    else if (!isSettingUp)
                    {
                        <button class="btn btn-primary" @onclick="StartSetupAsync" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Generating Setup...</span>
                            }
                            else
                            {
                                <i class="bi bi-qr-code-scan me-1"></i>
                                <span>Set Up Authenticator</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Active Setup Wizard -->
    @if (isSettingUp && setupData != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-qr-code me-2 text-info"></i> Authenticator App Setup
                </h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <!-- Step 1: Scan QR or Enter Key -->
                <div class="row g-4 align-items-center mb-4 pb-4 border-bottom">
                    <div class="col-12 col-md-5 text-center">
                        <div class="p-3 bg-white rounded border d-inline-block shadow-sm">
                            <img src="@setupData.QrCodeDataUrl" alt="2FA QR Code" class="img-fluid" style="width: 190px; height: 190px;" />
                        </div>
                        <div class="text-muted small mt-2">
                            <i class="bi bi-camera me-1"></i> Scan with Google Authenticator, Microsoft Authenticator, or Authy
                        </div>
                    </div>

                    <div class="col-12 col-md-7">
                        <h6 class="fw-bold text-dark mb-2">Can't scan the QR code?</h6>
                        <p class="text-muted small mb-3">
                            You can manually enter the secret setup key into your authenticator application:
                        </p>

                        <div class="input-group mb-2">
                            <input type="text" class="form-control font-monospace bg-light fw-bold text-center" value="@setupData.FormattedSharedKey" readonly />
                            <button class="btn btn-outline-secondary" type="button" @onclick="CopyKeyToClipboard" title="Copy key">
                                <i class="bi bi-clipboard me-1"></i> Copy
                            </button>
                        </div>
                        @if (copiedMessage)
                        {
                            <span class="text-success small"><i class="bi bi-check2"></i> Secret key copied to clipboard!</span>
                        }

                        <div class="alert alert-light border py-2 px-3 small mt-3 mb-0 text-muted">
                            <strong>Type:</strong> Time-based (TOTP) &bull; <strong>Algorithm:</strong> SHA1 &bull; <strong>Digits:</strong> 6
                        </div>
                    </div>
                </div>

                <!-- Step 2: Verification Code -->
                <div class="bg-light p-4 rounded border mb-4">
                    <h6 class="fw-bold mb-2">Verify Configuration</h6>
                    <p class="text-muted small mb-3">
                        Enter the 6-digit code currently showing in your authenticator app to confirm everything is linked correctly.
                    </p>

                    <div class="row justify-content-center">
                        <div class="col-12 col-sm-8 col-md-6 text-center">
                            <label class="form-label small fw-semibold text-muted text-uppercase d-block mb-2">6-Digit Verification Code</label>
                            <input type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   maxlength="6"
                                   autocomplete="one-time-code"
                                   placeholder="000000"
                                   class="form-control form-control-lg text-center fs-2 font-monospace py-2 mb-3 border-2"
                                   style="letter-spacing: 0.5rem;"
                                   @bind="verificationCode"
                                   @bind:event="oninput"
                                   @onkeydown="HandleVerifyKeyDown"
                                   disabled="@isVerifying"
                                   autofocus />

                            <div class="d-flex gap-2 justify-content-center">
                                <button type="button" class="btn btn-outline-secondary" @onclick="@(() => isSettingUp = false)" disabled="@isVerifying">
                                    Cancel
                                </button>
                                <button type="button" class="btn btn-success fw-semibold px-4" @onclick="ConfirmEnable2FaAsync" disabled="@(isVerifying || string.IsNullOrWhiteSpace(verificationCode) || verificationCode.Length < 6)">
                                    @if (isVerifying)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Verifying...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-1"></i>
                                        <span>Confirm &amp; Enable</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Step 3: Emergency Recovery Codes (Shown ONCE after activation) -->
    @if (generatedRecoveryCodes != null && generatedRecoveryCodes.Any())
    {
        <div class="card shadow-lg border-warning mb-4">
            <div class="card-header bg-warning bg-opacity-25 border-warning py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Save Your Emergency Recovery Codes</h5>
                        <small class="text-muted">These codes will ONLY be shown once. Please store them securely.</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning py-2 mb-4 small">
                    <strong>Critical:</strong> If you lose your mobile device or cannot access your authenticator app, these one-time codes are the <strong>only way</strong> to regain access to your ECL account without an administrator reset.
                </div>

                <div class="bg-light p-4 rounded border font-monospace mb-4">
                    <div class="row g-3">
                        @foreach (var recoveryCode in generatedRecoveryCodes)
                        {
                            <div class="col-6 col-md-4 text-center">
                                <span class="badge bg-white text-dark border px-3 py-2 fs-6 shadow-sm w-100">
                                    @recoveryCode
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyRecoveryCodes">
                            <i class="bi bi-clipboard me-1"></i> Copy All Codes
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DownloadRecoveryCodes">
                            <i class="bi bi-download me-1"></i> Download (.txt)
                        </button>
                    </div>

                    <button type="button" class="btn btn-primary" @onclick="DismissRecoveryCodes">
                        <i class="bi bi-check-lg me-1"></i> I Have Saved These Codes
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Disable Modal Confirmation -->
    @if (showDisableModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-danger text-white py-3">
                        <h5 class="modal-title fw-bold mb-0">Disable Two-Factor Authentication?</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showDisableModal = false)"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">
                            Disabling 2FA will lower your account security. To confirm, enter a current 6-digit code from your authenticator app (or leave empty if you are an ECL administrator):
                        </p>
                        <input type="text"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="000000 (Optional)"
                               class="form-control text-center font-monospace fs-4 py-2"
                               @bind="disableCode" />
                    </div>
                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => showDisableModal = false)">Cancel</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDisable2FaAsync">
                            Confirm &amp; Disable
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool is2FaActive = false;
    private bool isSettingUp = false;
    private bool isLoading = false;
    private bool isVerifying = false;
    private bool copiedMessage = false;

    private TwoFactorSetupDto? setupData;
    private string verificationCode = "";
    private List<string>? generatedRecoveryCodes;

    private bool showDisableModal = false;
    private string disableCode = "";

    private string? statusMessage;
    private bool isStatusError;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated || UserSession.CurrentUser == null)
        {
            Navigation.NavigateTo("login");
            return;
        }

        await RefreshUserStatusAsync();
    }

    private async Task RefreshUserStatusAsync()
    {
        var user = await UserService.GetUserByIdAsync(UserSession.CurrentUser!.Id);
        if (user != null)
        {
            is2FaActive = user.TwoFactorEnabled;
        }
    }

    private async Task StartSetupAsync()
    {
        isLoading = true;
        statusMessage = null;
        try
        {
            setupData = await UserService.GenerateTwoFactorSetupAsync(UserSession.CurrentUser!.Id);
            verificationCode = "";
            isSettingUp = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to start 2FA setup: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleVerifyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(verificationCode) && verificationCode.Length >= 6)
        {
            await ConfirmEnable2FaAsync();
        }
    }

    private async Task ConfirmEnable2FaAsync()
    {
        if (string.IsNullOrWhiteSpace(verificationCode)) return;

        isVerifying = true;
        statusMessage = null;
        try
        {
            var (success, msg, recoveryCodes) = await UserService.EnableTwoFactorAsync(UserSession.CurrentUser!.Id, verificationCode);
            if (success)
            {
                is2FaActive = true;
                isSettingUp = false;
                generatedRecoveryCodes = recoveryCodes;
                statusMessage = msg;
                isStatusError = false;

                // Update session state
                var updatedUser = await UserService.GetUserByIdAsync(UserSession.CurrentUser!.Id);
                if (updatedUser != null)
                {
                    UserSession.SetCurrentUser(updatedUser);
                }
            }
            else
            {
                statusMessage = msg;
                isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Verification error: {ex.Message}";
            isStatusError = true;
        }
        finally
        {
            isVerifying = false;
        }
    }

    private void OpenDisablePrompt()
    {
        disableCode = "";
        showDisableModal = true;
    }

    private async Task ConfirmDisable2FaAsync()
    {
        showDisableModal = false;
        statusMessage = null;
        try
        {
            var (success, msg) = await UserService.DisableTwoFactorAsync(UserSession.CurrentUser!.Id, disableCode);
            if (success)
            {
                is2FaActive = false;
                isSettingUp = false;
                generatedRecoveryCodes = null;
                statusMessage = msg;
                isStatusError = false;

                var updatedUser = await UserService.GetUserByIdAsync(UserSession.CurrentUser!.Id);
                if (updatedUser != null)
                {
                    UserSession.SetCurrentUser(updatedUser);
                }
            }
            else
            {
                statusMessage = msg;
                isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error disabling 2FA: {ex.Message}";
            isStatusError = true;
        }
    }

    private async Task CopyKeyToClipboard()
    {
        if (setupData != null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", setupData.SharedKey);
            copiedMessage = true;
            StateHasChanged();
            await Task.Delay(3000);
            copiedMessage = false;
            StateHasChanged();
        }
    }

    private async Task CopyRecoveryCodes()
    {
        if (generatedRecoveryCodes != null)
        {
            string allCodes = string.Join("\n", generatedRecoveryCodes);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", allCodes);
            statusMessage = "All 10 emergency recovery codes copied to clipboard.";
            isStatusError = false;
        }
    }

    private async Task DownloadRecoveryCodes()
    {
        if (generatedRecoveryCodes != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("EASTERN COALFIELDS LIMITED - EBIOS PORTAL");
            sb.AppendLine($"EMERGENCY 2FA RECOVERY CODES FOR: {UserSession.CurrentUser?.Username}");
            sb.AppendLine($"Generated on: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
            sb.AppendLine("--------------------------------------------------");
            sb.AppendLine("Keep these codes safe. Each code can be used ONCE to log in if you lose your authenticator device.");
            sb.AppendLine();
            foreach (var code in generatedRecoveryCodes)
            {
                sb.AppendLine(code);
            }

            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            string base64 = Convert.ToBase64String(bytes);
            string fileName = $"ECL_2FA_Recovery_Codes_{UserSession.CurrentUser?.Username}.txt";
            string js = $@"
                var link = document.createElement('a');
                link.download = '{fileName}';
                link.href = 'data:text/plain;charset=utf-8;base64,{base64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ";
            await JS.InvokeVoidAsync("eval", js);
        }
    }

    private void DismissRecoveryCodes()
    {
        generatedRecoveryCodes = null;
    }
}
