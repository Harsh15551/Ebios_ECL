@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public BiometricFormDto? Model { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public string CurrentUser { get; set; } = "APM";

    private bool isSaving = false;
    private bool consentError = false;
    private string? statusMessage;
    private string? errorMessage;

    private async Task Close()
    {
        statusMessage = null;
        errorMessage = null;
        await OnClosed.InvokeAsync();
    }

    private void OnRegistrationDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            if (Model != null) Model.RegistrationDateTime = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        }
    }

    private async Task SaveFormAsync()
    {
        if (Model == null) return;
        errorMessage = null;
        statusMessage = null;

        if (!Model.HasAadhaarConsent)
        {
            consentError = true;
            errorMessage = "Statutory worker consent and Aadhaar masking confirmation is mandatory before saving.";
            return;
        }
        consentError = false;

        isSaving = true;

        try
        {
            Model = await BiometricService.SaveFormAsync(
                Model, 
                CurrentUser,
                performedByUserId: UserSession.CurrentUser?.Id,
                performedByUsername: UserSession.CurrentUser?.Username,
                performedByOfficerName: UserSession.CurrentUser?.FullName,
                performedByRole: UserSession.CurrentUser?.Role.ToString()
            );
            statusMessage = "Biometric form particulars saved successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving form: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e, string boxType)
    {
        if (Model == null) return;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var file = e.File;
            if (file == null) return;

            // Limit image upload to 10MB
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var relativePath = await BiometricService.UploadPhotoAsync(
                Model.EmpCode, 
                boxType, 
                stream, 
                file.Name, 
                CurrentUser,
                performedByUserId: UserSession.CurrentUser?.Id,
                performedByUsername: UserSession.CurrentUser?.Username,
                performedByOfficerName: UserSession.CurrentUser?.FullName,
                performedByRole: UserSession.CurrentUser?.Role.ToString()
            );

            // Refresh model DTO
            Model = await BiometricService.GetOrCreateFormByEmpCodeAsync(Model.EmpCode);
            Model.PhotoCacheKey = DateTime.UtcNow.Ticks;
            statusMessage = $"Photo for {boxType} uploaded and saved to local storage!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to upload photo: {ex.Message}";
        }
    }

    private async Task UploadSignedPhysicalFormAsync(InputFileChangeEventArgs e)
    {
        if (Model == null) return;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var file = e.File;
            if (file == null) return;

            // Allow up to 25MB for scanned PDF
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var relativePath = await BiometricService.UploadSignedPhysicalFormAsync(
                Model.EmpCode, 
                stream, 
                file.Name, 
                CurrentUser,
                performedByUserId: UserSession.CurrentUser?.Id,
                performedByUsername: UserSession.CurrentUser?.Username,
                performedByOfficerName: UserSession.CurrentUser?.FullName,
                performedByRole: UserSession.CurrentUser?.Role.ToString()
            );

            Model = await BiometricService.GetOrCreateFormByEmpCodeAsync(Model.EmpCode);
            statusMessage = "Scanned completed physical form uploaded successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to upload physical form: {ex.Message}";
        }
    }

    private async Task PrintForm()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}

