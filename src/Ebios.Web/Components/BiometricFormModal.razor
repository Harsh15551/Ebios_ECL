@inject IBiometricFormService BiometricService
@inject UserSessionService UserSession
@inject IJSRuntime JS

@if (IsOpen && Model != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060; overflow-y: auto;">
        <div class="modal-dialog modal-xl modal-dialog-centered my-4" style="max-width: 1000px;">
            <div class="modal-content shadow-lg border-0">
                <!-- Modal Header (Hidden during print) -->
                <div class="modal-header bg-dark text-white no-print py-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">📋</span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">ECL Biometric Registration Template</h5>
                            <small class="text-light opacity-75">Worker: @Model.EmployeeName (@Model.EmpCode)</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" @onclick="PrintForm">
                            <i class="bi bi-printer me-1"></i> 🖨️ Print / Save as PDF
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                    </div>
                </div>

                <!-- Modal Body: Printable Official Template -->
                <div class="modal-body p-4 bg-white" id="printableBiometricForm">
                    <!-- Alerts (Hidden during print) -->
                    @if (!Model.EmployeeId.HasValue)
                    {
                        <div class="alert alert-warning py-2 px-3 d-flex justify-content-between align-items-center mb-3 no-print">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5">🚩</span>
                                <div>
                                    <strong>Worker Not Yet Onboarded:</strong> No active employee master record exists for Employee ID <code>@Model.EmpCode</code>.
                                    <div class="small text-muted">Saving this biometric form will automatically onboard this worker (EmpID: @Model.EmpCode, Name: @Model.EmployeeName) once a valid Colliery Unit is specified in Department / Unit.</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary fw-semibold text-nowrap" @onclick="SaveFormAsync" disabled="@isSaving">
                                <i class="bi bi-person-plus me-1"></i> Onboard Worker Now
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 px-3 d-flex align-items-center gap-2 mb-3 no-print">
                            <span class="fs-5">👤</span>
                            <div>
                                <strong>Active Onboarded Worker:</strong> <code>@Model.EmpCode</code> is linked to an active employee profile. Saving will update biometric particulars and photographs.
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show no-print py-2 mb-3" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @statusMessage
                            <button type="button" class="btn-close py-2" @onclick="@(() => statusMessage = null)"></button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show no-print py-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
                            <button type="button" class="btn-close py-2" @onclick="@(() => errorMessage = null)"></button>
                        </div>
                    }

                    <!-- Printable Template Container -->
                    <div class="ecl-biometric-template border border-dark p-3 p-md-4">
                        <!-- Official Document Title -->
                        <div class="text-center mb-4 pb-2 border-bottom border-dark">
                            <h4 class="fw-bold text-uppercase tracking-wide mb-1" style="font-family: 'Times New Roman', serif; font-size: 1.35rem; letter-spacing: 0.5px;">
                                BIOMETRIC REGISTRATION TEMPLATE FOR EMPLOYEES OF ECL
                            </h4>
                            <div class="text-muted small fw-semibold" style="font-size: 0.85rem;">
                                EASTERN COALFIELDS LIMITED &bull; ELECTRONICS CORPORATION (WEBEL)
                            </div>
                        </div>

                        <!-- SECTION 1: DETAILS OF THE PERSON APPEARED AT REGISTRATION -->
                        <div class="mb-4">
                            <div class="fw-bold text-uppercase mb-2" style="font-size: 0.95rem; font-family: 'Times New Roman', serif;">
                                DETAILS OF THE PERSON APPEARED AT REGISTRATION:
                            </div>

                            <table class="table table-bordered border-dark align-middle mb-0 particulars-table" style="font-size: 0.9rem;">
                                <thead style="background-color: #f3f4f6;">
                                    <tr>
                                        <th style="width: 8%; text-align: center;" class="py-1">S. No.</th>
                                        <th style="width: 42%;" class="py-1">Description</th>
                                        <th style="width: 50%;" class="py-1">Particulars</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-center fw-bold py-1">1</td>
                                        <td class="py-1">Employee ID</td>
                                        <td class="py-1 fw-bold">@Model.EmpCode</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">2</td>
                                        <td class="py-1">Employee Name</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent fw-semibold" @bind="Model.EmployeeName" placeholder="Enter Full Name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">3</td>
                                        <td class="py-1">Aadhaar Number</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.AadhaarNumber" placeholder="XXXX-XXXX-XXXX" maxlength="14" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">4</td>
                                        <td class="py-1">Category of Employee</td>
                                        <td class="py-1">
                                            <select class="form-select form-select-sm border-0 bg-transparent" @bind="Model.Category">
                                                <option value="Non-Executive">Non-Executive</option>
                                                <option value="Executive">Executive</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">5</td>
                                        <td class="py-1">Position/ Designation</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.PositionDesignation" placeholder="e.g. Colliery Worker / Mining Sirdar" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">6</td>
                                        <td class="py-1">Department / Unit</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.DepartmentUnit" placeholder="e.g. Pithead Unit 1" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">7</td>
                                        <td class="py-1">Place of Posting</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.PlaceOfPosting" placeholder="e.g. Sodepur Area" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">8</td>
                                        <td class="py-1">Registration Date &amp; Time</td>
                                        <td class="py-1">
                                            <input type="datetime-local" class="form-control form-control-sm border-0 bg-transparent" 
                                                   value="@(Model.RegistrationDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")" 
                                                   @onchange="OnRegistrationDateChanged" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">9</td>
                                        <td class="py-1">Location of Registration</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.RegistrationLocation" placeholder="e.g. Pithead Biometric Desk" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">10</td>
                                        <td class="py-1">Name of Controlling Officer</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.ControllingOfficerName" placeholder="Controlling Officer Name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center fw-bold py-1">11</td>
                                        <td class="py-1">Designation of Controlling Officer</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.ControllingOfficerDesignation" placeholder="e.g. Senior Manager (Mining) / Agent" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- SECTION 2: RELEVANT PHOTOGRAPHS (2x2 Official Grid) -->
                        <div class="mb-4">
                            <div class="fw-bold text-uppercase mb-2" style="font-size: 0.95rem; font-family: 'Times New Roman', serif;">
                                RELEVANT PHOTOGRAPHS:
                            </div>

                            <table class="table table-bordered border-dark text-center align-middle mb-0 photo-grid-table">
                                <tbody>
                                    <!-- Row 1: Top Two Photo Boxes -->
                                    <tr style="height: 180px;">
                                        <!-- Box 1: Aadhaar Card Photo -->
                                        <td style="width: 50%; vertical-align: middle; position: relative; background-color: #fafafa;" class="p-2">
                                            @if (!string.IsNullOrEmpty(Model.AadhaarPhotoUrl))
                                            {
                                                <div class="photo-container text-center">
                                                    <img src="@Model.AadhaarPhotoUrl" alt="Aadhaar Card" class="img-fluid border" style="max-height: 150px; max-width: 95%; object-fit: contain;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted p-3 border border-dashed rounded bg-light">
                                                    <i class="bi bi-card-image fs-1 d-block text-secondary"></i>
                                                    <span class="small">[Aadhaar Card Photo]</span>
                                                </div>
                                            }
                                            <div class="mt-2 no-print">
                                                <label class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; cursor: pointer;">
                                                    <i class="bi bi-upload me-1"></i> Choose File
                                                    <InputFile OnChange="@(e => UploadPhotoAsync(e, "aadhaar"))" accept="image/*" class="d-none" />
                                                </label>
                                                <div class="mt-1">
                                                    <span class="badge bg-info-subtle text-dark border border-info text-wrap" style="font-size: 0.65rem;" title="UIDAI Rule: First 8 digits must be masked">
                                                        <i class="bi bi-shield-lock-fill text-primary me-1"></i>Masked Aadhaar Only (XXXX-XXXX-1234)
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Box 2: ID Card (other than Aadhaar) -->
                                        <td style="width: 50%; vertical-align: middle; position: relative; background-color: #fafafa;" class="p-2">
                                            @if (!string.IsNullOrEmpty(Model.IdCardPhotoUrl))
                                            {
                                                <div class="photo-container text-center">
                                                    <img src="@Model.IdCardPhotoUrl" alt="Other ID Card" class="img-fluid border" style="max-height: 150px; max-width: 95%; object-fit: contain;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted p-3 border border-dashed rounded bg-light">
                                                    <i class="bi bi-person-badge fs-1 d-block text-secondary"></i>
                                                    <span class="small">[Other ID Card Photo]</span>
                                                </div>
                                            }
                                            <div class="mt-2 no-print">
                                                <label class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; cursor: pointer;">
                                                    <i class="bi bi-upload me-1"></i> Choose File
                                                    <InputFile OnChange="@(e => UploadPhotoAsync(e, "idcard"))" accept="image/*" class="d-none" />
                                                </label>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Labels Row 1 -->
                                    <tr style="background-color: #f3f4f6; font-size: 0.85rem;" class="fw-semibold">
                                        <td class="py-1">Photo of Aadhaar Card Produced at time of Registration</td>
                                        <td class="py-1">Photo of ID Card (other than Aadhaar, if any) Produced at time of Registration</td>
                                    </tr>

                                    <!-- Row 2: Bottom Two Photo Boxes -->
                                    <tr style="height: 180px;">
                                        <!-- Box 3: Person Appeared -->
                                        <td style="width: 50%; vertical-align: middle; position: relative; background-color: #fafafa;" class="p-2">
                                            @if (!string.IsNullOrEmpty(Model.PersonPhotoUrl))
                                            {
                                                <div class="photo-container text-center">
                                                    <img src="@Model.PersonPhotoUrl" alt="Person Appeared" class="img-fluid border" style="max-height: 150px; max-width: 95%; object-fit: contain;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted p-3 border border-dashed rounded bg-light">
                                                    <i class="bi bi-person-square fs-1 d-block text-secondary"></i>
                                                    <span class="small">[Person Photo]</span>
                                                </div>
                                            }
                                            <div class="mt-2 no-print">
                                                <label class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; cursor: pointer;">
                                                    <i class="bi bi-upload me-1"></i> Choose File
                                                    <InputFile OnChange="@(e => UploadPhotoAsync(e, "person"))" accept="image/*" class="d-none" />
                                                </label>
                                            </div>
                                        </td>

                                        <!-- Box 4: Template Saved in Machine -->
                                        <td style="width: 50%; vertical-align: middle; position: relative; background-color: #fafafa;" class="p-2">
                                            @if (!string.IsNullOrEmpty(Model.TemplatePhotoUrl))
                                            {
                                                <div class="photo-container text-center">
                                                    <img src="@Model.TemplatePhotoUrl" alt="Machine Template" class="img-fluid border" style="max-height: 150px; max-width: 95%; object-fit: contain;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted p-3 border border-dashed rounded bg-light">
                                                    <i class="bi bi-fingerprint fs-1 d-block text-secondary"></i>
                                                    <span class="small">[Machine Template Photo]</span>
                                                </div>
                                            }
                                            <div class="mt-2 no-print">
                                                <label class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem; cursor: pointer;">
                                                    <i class="bi bi-upload me-1"></i> Choose File
                                                    <InputFile OnChange="@(e => UploadPhotoAsync(e, "template"))" accept="image/*" class="d-none" />
                                                </label>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Labels Row 2 -->
                                    <tr style="background-color: #f3f4f6; font-size: 0.85rem;" class="fw-semibold">
                                        <td class="py-1">Photo of Person appeared at Registration</td>
                                        <td class="py-1">Template Saved in Machine</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- SECTION 3: PERSONNEL PRESENT DURING REGISTRATION (From ECL and WEBEL) -->
                        <div class="mb-4">
                            <div class="fw-bold text-uppercase mb-2" style="font-size: 0.95rem; font-family: 'Times New Roman', serif;">
                                PERSONNEL PRESENT DURING REGISTRATION (From ECL and WEBEL):
                            </div>

                            <table class="table table-bordered border-dark align-middle mb-0 committee-table" style="font-size: 0.9rem;">
                                <thead style="background-color: #f3f4f6;">
                                    <tr>
                                        <th style="width: 8%; text-align: center;" class="py-1">S. No.</th>
                                        <th style="width: 32%;" class="py-1">Name</th>
                                        <th style="width: 28%;" class="py-1">Designation</th>
                                        <th style="width: 16%;" class="py-1">Department</th>
                                        <th style="width: 16%;" class="py-1">Organization</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Row 1: HR ECL -->
                                    <tr>
                                        <td class="text-center fw-bold py-1">1</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.EclHrName" placeholder="Enter HR Name" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.EclHrDesignation" placeholder="e.g. Assistant Manager (HR)" />
                                        </td>
                                        <td class="py-1 fw-semibold">HR</td>
                                        <td class="py-1 fw-semibold">ECL</td>
                                    </tr>

                                    <!-- Row 2: Security ECL -->
                                    <tr>
                                        <td class="text-center fw-bold py-1">2</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.EclSecurityName" placeholder="Enter Security Officer Name" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.EclSecurityDesignation" placeholder="e.g. Security Inspector" />
                                        </td>
                                        <td class="py-1 fw-semibold">Security</td>
                                        <td class="py-1 fw-semibold">ECL</td>
                                    </tr>

                                    <!-- Row 3: WEBEL -->
                                    <tr>
                                        <td class="text-center fw-bold py-1">3</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.WebelName" placeholder="Enter WEBEL Representative" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.WebelDesignation" placeholder="e.g. Site Engineer" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.WebelDepartment" placeholder="Technical" />
                                        </td>
                                        <td class="py-1 fw-semibold">WEBEL</td>
                                    </tr>

                                    <!-- Row 4: ECL / WEBEL -->
                                    <tr>
                                        <td class="text-center fw-bold py-1">4</td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.Witness4Name" placeholder="Enter Witness Name" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.Witness4Designation" placeholder="e.g. Supervisor" />
                                        </td>
                                        <td class="py-1">
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent" @bind="Model.Witness4Department" placeholder="Operations" />
                                        </td>
                                        <td class="py-1 fw-semibold">ECL / WEBEL</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Statutory Aadhaar Compliance & Worker Consent Declaration -->
                        <div class="mt-3 p-2 border rounded bg-light" style="font-size: 0.76rem;">
                            <strong>Statutory Declaration:</strong> Aadhaar number and biometric identifiers are collected in masked format (XXXX-XXXX-XXXX) with the employee's voluntary consent solely for mine-gate safety, access control, and attendance muster verification under Coal Mines Regulations, in compliance with UIDAI and DPDP Act guidelines.
                        </div>

                        <div class="no-print mt-2">
                            <div class="form-check p-2 bg-white border @(consentError ? "border-danger" : "border-info") rounded">
                                <input class="form-check-input ms-0 me-2" type="checkbox" id="aadhaarConsentCheck" @bind="Model.HasAadhaarConsent" />
                                <label class="form-check-label small fw-bold text-dark" for="aadhaarConsentCheck">
                                    <i class="bi bi-shield-check text-success me-1"></i>
                                    I confirm that the uploaded Aadhaar document is masked (first 8 digits hidden, e.g. XXXX-XXXX-1234) and the worker has provided voluntary consent for biometric registration.
                                </label>
                            </div>
                            @if (consentError)
                            {
                                <div class="text-danger small mt-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    You must confirm the statutory Aadhaar masking and worker consent checkbox before saving.
                                </div>
                            }
                        </div>

                        <!-- SECTION 4: SCANNED SIGNED PAPER FORM (No-print, or download link) -->
                        <div class="no-print border-top pt-3 mt-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold">📎 Uploaded Manually Completed &amp; Signed Form:</span>
                                    @if (!string.IsNullOrEmpty(Model.SignedPhysicalFormUrl))
                                    {
                                        <a href="@Model.SignedPhysicalFormUrl" target="_blank" class="ms-2 badge bg-success text-decoration-none p-2">
                                            <i class="bi bi-file-earmark-check me-1"></i> View Scanned Hardcopy Form
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted ms-2 small">No scanned hardcopy uploaded yet</span>
                                    }
                                </div>
                                <div>
                                    <label class="btn btn-sm btn-outline-dark" style="cursor: pointer;">
                                        <i class="bi bi-file-earmark-arrow-up me-1"></i> Upload Signed Copy (PDF/JPG)
                                        <InputFile OnChange="UploadSignedPhysicalFormAsync" accept=".pdf,.jpg,.jpeg,.png" class="d-none" />
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer (Hidden during print) -->
                <div class="modal-footer bg-light no-print py-2 d-flex justify-content-between">
                    <div>
                        <span class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i> Photos are stored locally on server disk to conserve database space.
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
                        <button type="button" class="btn btn-success" @onclick="SaveFormAsync" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-check-lg me-1"></i> Save Form Particulars</span>
                            }
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="PrintForm">
                            <i class="bi bi-printer me-1"></i> 🖨️ Print Official Template
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@page {
        size: A4 portrait;
        margin: 8mm 10mm 8mm 10mm;
    }

    @@media print {
        html, body {
            height: auto !important;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            overflow: visible !important;
        }

        /* Hide layout navigation, sidebar, top-row, and outer page elements */
        .sidebar, .top-row, .navbar, header, nav, .card:not(.modal *), .btn:not(.modal *), .alert:not(.modal *), .no-print, .no-print * {
            display: none !important;
        }

        /* Hide all page content siblings outside the modal */
        article.content > *:not(.modal),
        main > *:not(article),
        .page > *:not(main) {
            display: none !important;
        }

        .no-print, .no-print * {
            display: none !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
        }

        .modal-backdrop {
            display: none !important;
        }

        .modal {
            position: static !important;
            display: block !important;
            overflow: visible !important;
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
            width: 100% !important;
            min-height: 0 !important;
        }

        .modal-dialog {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            transform: none !important;
        }

        .modal-content {
            border: none !important;
